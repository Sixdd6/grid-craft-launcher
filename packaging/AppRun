#!/usr/bin/env bash
# AppImage entry point. Runs the Slint UI by default.
# `--cli` runs the `gcl` command line tool with the remaining arguments.
HERE="$(dirname "$(readlink -f "$0")")"

if [ "${1:-}" = "--cli" ]; then
    shift
    exec "$HERE/usr/bin/gcl" "$@"
fi

exec "$HERE/usr/bin/grid-craft-launcher" "$@"
