{
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(just *)",
      "Bash(git *)",
      "Bash(slint-viewer *)",
      "Bash(scripts/*)",
      "WebFetch(domain:piston-meta.mojang.com)",
      "WebFetch(domain:launchermeta.mojang.com)",
      "WebFetch(domain:meta.fabricmc.net)",
      "WebFetch(domain:meta.quiltmc.org)",
      "WebFetch(domain:maven.minecraftforge.net)",
      "WebFetch(domain:maven.neoforged.net)",
      "WebFetch(domain:api.modrinth.com)",
      "WebFetch(domain:docs.modrinth.com)",
      "WebFetch(domain:docs.curseforge.com)",
      "WebFetch(domain:docs.slint.dev)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:minecraft.wiki)",
      "WebFetch(domain:api.curseforge.com)",
      "WebFetch(domain:login.microsoftonline.com)",
      "WebFetch(domain:user.auth.xboxlive.com)",
      "WebFetch(domain:xsts.auth.xboxlive.com)",
      "WebFetch(domain:api.minecraftservices.com)",
      "WebFetch(domain:resources.download.minecraft.net)",
      "WebFetch(domain:libraries.minecraft.net)",
      "WebFetch(domain:maven.fabricmc.net)",
      "WebFetch(domain:maven.quiltmc.org)",
      "WebFetch(domain:api.adoptium.net)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(cat .env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/fmt-on-edit.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/check-on-stop.sh", "timeout": 600 }]
      }
    ]
  }
}
