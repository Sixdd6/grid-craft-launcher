import { Theme } from "../theme.slint";
import { Screen } from "../types.slint";

// One rail entry: a label. The active entry gets a filled background, bold weight, and an
// accent bar on its left edge; a digit still switches to it (see `keys::key_to_screen`) but
// the digit is not printed.
component Entry inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: Theme.row-height;
    border-radius: Theme.radius-row;
    clip: true;
    background: root.active
        ? Theme.surface-hover
        : (touch.has-hover ? Theme.surface-hover : Colors.transparent);

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Accent bar on the active entry's left edge.
    Rectangle {
        x: 0;
        width: Theme.accent-stripe;
        height: 100%;
        background: Theme.accent;
        visible: root.active;
    }

    HorizontalLayout {
        padding-left: Theme.pad-entry;
        padding-right: Theme.pad-entry;

        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.font-size;
            font-weight: root.active ? Theme.font-weight-medium : Theme.font-weight-regular;
            vertical-alignment: center;
        }
    }

    animate background { duration: Theme.motion-fast; }
}

// Left navigation rail. One entry per screen; the active entry is highlighted.
export component Rail inherits Rectangle {
    in property <Screen> current: Screen.instances;
    callback navigate(Screen);

    width: Theme.rail-width;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.pad;
        spacing: 2px;

        Text {
            text: "GRID Craft";
            color: Theme.text;
            font-size: Theme.font-size-title;
            height: Theme.row-height + Theme.gap;
            vertical-alignment: center;
        }

        rail_instances := Entry {
            label: "Instances";
            active: root.current == Screen.instances;
            clicked => { root.navigate(Screen.instances); }
        }
        rail_instance := Entry {
            label: "Instance";
            active: root.current == Screen.instance;
            clicked => { root.navigate(Screen.instance); }
        }
        rail_browser := Entry {
            label: "Browse";
            active: root.current == Screen.browser;
            clicked => { root.navigate(Screen.browser); }
        }
        rail_accounts := Entry {
            label: "Accounts";
            active: root.current == Screen.accounts;
            clicked => { root.navigate(Screen.accounts); }
        }
        rail_settings := Entry {
            label: "Settings";
            active: root.current == Screen.settings;
            clicked => { root.navigate(Screen.settings); }
        }

        Rectangle { }
    }

    // 1px right border.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }
}
