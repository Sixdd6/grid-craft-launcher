import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Block } from "../types.slint";

// Renders one project description or version changelog as a column of blocks, styled by kind.
// Both `ProjectScreen`'s Description tab and `NotesDialog` instantiate this, so a table, an
// image, or a quote renders the same way in either place.
//
// Pure layout, per the `slint-ui` skill: it holds no fetch state of its own. An `image` block's
// `image`/`image_state` fields are filled in place by `screens/project.rs` once that image is
// fetched and decoded (see `types.slint`'s doc comment on `Block`), so this component only ever
// reads what is already on the block.
export component BlockList inherits VerticalLayout {
    in property <[Block]> blocks: [];
    spacing: Theme.gap;
    alignment: start;

    for block in root.blocks: block_item := VerticalLayout {
        if block.kind == "code": code_pane := Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius;

            VerticalLayout {
                padding: Theme.pad;

                Text {
                    text: block.text;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    font-family: Theme.font-family-mono;
                    wrap: word-wrap;
                }
            }
        }

        if block.kind == "rule": Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if block.kind == "quote": HorizontalLayout {
            spacing: Theme.gap;

            Rectangle {
                width: Theme.accent-stripe;
                background: Theme.accent;
            }

            Text {
                text: block.text;
                color: Theme.text-muted;
                font-size: Theme.font-size;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        if block.kind == "table": table_pane := Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius;

            property <int> table_columns: max(block.columns, 1);
            property <int> table_rows: block.columns > 0 ? block.cells.length / block.columns : 0;
            // A plain `Rectangle` has no preferred size of its own: unlike a layout, it does
            // not grow to fit a child that sets its own height, so the tile's height tracks
            // the row layout's own preferred height instead of a row count times a guessed
            // line height — a cell whose text wraps onto two lines grows the tile with it.
            height: table_row_layout.preferred-height + 2 * Theme.pad;

            // Wrapped in its own `ScrollView` rather than the Description tab's outer one, so
            // a table wider than the screen scrolls sideways on its own tile instead of
            // widening the whole page. No vertical scrollbar: the tile is already sized to
            // its content, so there is never anything to scroll down to.
            ScrollView {
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                table_row_layout := HorizontalLayout {
                    padding: Theme.pad;
                    spacing: Theme.pad;

                    for col in table_pane.table_columns: column := VerticalLayout {
                        spacing: Theme.gap / 2;
                        min-width: Theme.label-width;
                        max-width: 3 * Theme.label-width;

                        for row in table_pane.table_rows: cell := Text {
                            text: block.cells[row * table_pane.table_columns + col];
                            color: Theme.text;
                            font-size: Theme.font-size-small;
                            font-weight: row == 0 ? Theme.font-weight-bold : Theme.font-weight-regular;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if block.kind == "image": image_pane := VerticalLayout {
            spacing: Theme.gap / 2;

            if block.image_state == "loading" || block.image_state == "": placeholder := Rectangle {
                height: Theme.icon-size * 2;
                background: Theme.surface-raised;
                border-radius: Theme.radius;

                Text {
                    text: "Loading image…";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if block.image_state == "failed": Text {
                text: block.text == "" ? "[Image]" : "[Image: " + block.text + "]";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }

            // Sized from the decoded image's own aspect ratio, so a wide banner stays a
            // banner instead of being squeezed into a fixed-height box: full width, and a
            // height that ratio gives, capped so a tall image cannot push the rest of the
            // column off screen.
            if block.image_state == "ready": image_tile := Image {
                source: block.image;
                width: 100%;
                height: min(
                    self.width * ((block.image.height * 1.0) / max(block.image.width, 1)),
                    Theme.icon-size * 8
                );
                image-fit: contain;
                horizontal-alignment: left;
            }

            if block.image_state == "ready" && block.text != "": Text {
                text: block.text;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }
        }

        // A fixed-width glyph column plus a wrapping text column, rather than one `Text` with
        // the bullet glued to its front: with only one `Text`, a wrapped second line starts
        // back at the margin, under the glyph rather than under the item's own text.
        if block.kind == "bullet": HorizontalLayout {
            padding-left: block.depth * 2 * Theme.gap;
            spacing: Theme.gap / 2;

            Text {
                text: "•";
                color: Theme.text;
                font-size: Theme.font-size;
                font-weight: Theme.font-weight-regular;
                horizontal-stretch: 0;
                width: Theme.font-size;
            }

            Text {
                text: block.text;
                color: Theme.text;
                wrap: word-wrap;
                font-size: Theme.font-size;
                font-weight: Theme.font-weight-regular;
                horizontal-stretch: 1;
            }
        }

        if block.kind != "code" && block.kind != "rule" && block.kind != "quote"
            && block.kind != "table" && block.kind != "image" && block.kind != "bullet": Text {
            text: block.text;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
            font-size: block.kind == "heading1" ? Theme.font-size-h1
                : (block.kind == "heading2" || block.kind == "heading3"
                    ? Theme.font-size-title
                    : Theme.font-size);
            font-weight: (block.kind == "heading1" || block.kind == "heading2"
                || block.kind == "heading3" || block.kind == "heading4"
                || block.kind == "heading5" || block.kind == "heading6")
                ? Theme.font-weight-bold
                : Theme.font-weight-regular;
        }
    }
}
