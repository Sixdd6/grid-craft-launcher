import { Theme } from "../theme.slint";

// A row of text tabs. `changed` carries the index the user picked.
export component TabBar inherits Rectangle {
    in property <[string]> tabs: ["Content", "Settings", "Logs"];
    in-out property <int> current: 0;
    callback changed(int);

    height: Theme.row-height;

    HorizontalLayout {
        spacing: Theme.gap;

        // Every entry carries the same id: a repeater cannot give each one its own. A test
        // takes the nth handle `find_by_element_id` yields, in tab order.
        for tab[index] in root.tabs: tab_entry := Rectangle {
            border-radius: Theme.radius;
            horizontal-stretch: 0;
            min-width: label.preferred-width + 2 * Theme.pad;
            background: index == root.current
                ? Colors.transparent
                : (touch.has-hover ? Theme.surface-hover : Colors.transparent);

            label := Text {
                text: tab;
                color: index == root.current ? Theme.text : Theme.text-muted;
                font-size: Theme.font-size;
                font-weight: index == root.current ? Theme.font-weight-medium : Theme.font-weight-regular;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            // The active tab's underline: an accent bar the width of the label, not the
            // whole entry, so it reads as pointing at the text.
            if index == root.current: Rectangle {
                x: (parent.width - label.preferred-width) / 2;
                y: parent.height - Theme.accent-stripe;
                width: label.preferred-width;
                height: Theme.accent-stripe;
                background: Theme.accent;
            }

            accessible-role: button;
            accessible-label: tab;
            accessible-action-default => {
                root.current = index;
                root.changed(index);
            }

            touch := TouchArea {
                clicked => {
                    root.current = index;
                    root.changed(index);
                }
            }
        }

        Rectangle { }
    }
}
