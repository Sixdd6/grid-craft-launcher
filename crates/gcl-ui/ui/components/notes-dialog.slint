import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Block } from "../types.slint";
import { BlockList } from "block-list.slint";
import { Dialog } from "dialog.slint";
import { EmptyState } from "empty-state.slint";

// One version's changelog in a modal, built on [`Dialog`]. `ProjectScreen`'s Versions tab opens
// this from a row's Notes button; `BlockList` is the same renderer the Description tab uses, so
// a table or an image in a changelog looks the same as one in the description.
//
// Mounted only while `open` is true, per the `slint-ui` skill's dialog rule, so Escape and the
// keyboard behave the same way every other dialog in `app.slint` does.
export component NotesDialog inherits Rectangle {
    in-out property <bool> open: true;
    // Already formatted by the caller: "<number> notes".
    in property <string> title: "";
    in property <[Block]> blocks: [];
    // True while the changelog is being fetched.
    in property <bool> loading: false;
    // One line about a fetch that failed, shown in place of "No notes". Empty otherwise.
    in property <string> status: "";

    // The user closed the modal, by its Close button, Escape, or a click outside the panel.
    callback close();

    Dialog {
        width: root.width;
        height: root.height;
        open: root.open;
        title: root.title;
        close-text: "Close";
        // A changelog is prose: the default panel width turns every wrapped paragraph into a
        // column of short lines. This is real text to read, so it gets the room a settings
        // form does not need.
        wide: true;
        close => {
            root.close();
        }

        // As tall as the notes need, up to sixteen rows: a long changelog scrolls inside the
        // panel instead of growing it past the screen, and a two-line one does not leave the
        // Close button stranded at the bottom of the window, where it lands outside the
        // screen's own scroll viewport and no pointer can reach it.
        notes_scroll := ScrollView {
            height: min(body.preferred-height, 16 * Theme.row-height);

            body := VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;
                alignment: start;

                if root.loading: Text {
                    text: "Loading…";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                }

                if !root.loading && root.status != "": Text {
                    text: root.status;
                    color: Theme.danger;
                    font-size: Theme.font-size-small;
                    wrap: word-wrap;
                }

                if !root.loading && root.status == "" && root.blocks.length == 0: EmptyState {
                    title: "No notes";
                }

                // Bound to the scroll view's own visible width, not left to stretch on its
                // own: a `ScrollView`'s viewport otherwise sizes to its content's natural
                // width, which for a column of wrapping `Text` is unbounded, so nothing ever
                // wraps and the panel clips its right edge instead. Binding to `body.width`
                // instead would be circular — `body`'s own width comes from this child's
                // preferred width in the first place.
                if !root.loading && root.status == "": BlockList {
                    width: notes_scroll.visible-width - 2 * Theme.pad;
                    blocks: root.blocks;
                }
            }
        }
    }
}
