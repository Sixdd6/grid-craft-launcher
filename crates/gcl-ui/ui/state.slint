import { AccountRow, ContentRow, GcPresetRow, LogLine, PendingRow, SettingRow, SettingRowModel } from "types.slint";

// The shell service a screen may reach.
//
// `App` itself lives in `app.slint`, which imports every screen, so a screen cannot import it
// back. This callback is the one screens genuinely need, so it lives here instead and
// `src/app.rs` binds it next to the rest of `App`.
export global Shell {
    // Where a list's selection lands after an arrow key. Carries the current index (-1 when
    // nothing is chosen), the step, and the row count, and returns the new index.
    callback move_selection(int /* current */, int /* delta */, int /* len */) -> int;
}

// Everything the typed game-settings editor reads and reports.
//
// One global serves both places the editor is mounted, because only one of them is on screen
// at a time: the settings screen edits the launcher preseed, the instance detail screen's
// Settings tab edits that instance's overrides. `src/screens/settings_editor.rs` owns it and
// knows which layer the open screen edits; the editor itself only shows rows and reports
// what the user did to them.
//
// `rows` is the visible list: a header line for every group, then that group's settings
// while the group is open. The search box filters it.
//
// Every property here starts empty. What the app shows is what Rust put here, so a default
// that carried sample data would be on screen until the first read answered. The sample
// rows the preview needs live in `PreviewSettingsScreen`, in `screens/settings.slint`.
export global SettingsEditorState {
    // The visible lines, headers included, in group order.
    in-out property <[SettingRowModel]> rows: [];
    // What the search box holds. An empty string shows every group.
    in-out property <string> search: "";
    // True while a save or a reload is running.
    in-out property <bool> busy: false;
    // One line under the editor about the last thing that happened here.
    in-out property <string> status: "";
    // What a saved value is called on the open screen: "default" or "override".
    in-out property <string> layer_name: "default";

    // A switch or a text field was set. Carries the key and the stored value.
    callback changed(string /* key */, string /* value */);
    // A slider was set. Carries the key and the number the user reads, which is not always
    // the number `options.txt` holds: `src/screens/settings_editor.rs` scales it back.
    callback slid(string /* key */, float /* shown */);
    // A choice was picked. Carries the key and the position in `choices`, which Rust maps
    // back to the token `options.txt` stores.
    callback chose(string /* key */, int /* index */);
    // A row's Reset button was pressed: drop the value this screen's layer holds.
    callback reset(string /* key */);
    // A group header was pressed: open or close that group. Carries the group name.
    callback toggle_group(string /* group */);
    // The search box changed. Carries what it holds now.
    callback search_changed(string);
}

// Everything the instance detail screen and its prompt read and report.
//
// The screen lives inside an `if` in `app.slint`, so Rust cannot reach its properties. This
// global is the seam, the same way `InstancesState` is for the list: `src/screens/instance.rs`
// binds it, and the screen reads it directly. It lives in its own file because the screen
// imports it and `app.slint` imports the screen, which a global declared in `app.slint` could
// not survive.
//
// Every property here starts empty: an instance nobody has opened has no name, no content
// and no log, and `src/screens/instance.rs` fills every one of them from disk. The sample
// values the preview needs live in `PreviewInstanceScreen`, at the end of this screen's file.
export global InstanceState {
    // Display name of the instance being shown.
    in-out property <string> name: "";
    // Its Minecraft version.
    in-out property <string> minecraft: "";
    // Its loader and build, already joined for display. "vanilla" when it has no loader.
    in-out property <string> loader_label: "";
    // Whether the version a launch resolves is already in the cache.
    in-out property <bool> installed: false;
    // Whether this instance's game is up.
    in-out property <bool> running: false;
    // One line about the last thing that happened here.
    in-out property <string> status_text: "";

    // Which tab is shown: 0 content, 1 settings, 2 jvm, 3 logs.
    in-out property <int> tab: 0;

    // Installed content, in install order.
    in-out property <[ContentRow]> content: [];
    // Downloads the user still has to fetch by hand.
    in-out property <[PendingRow]> pending: [];
    // Whether this instance has an `options.txt` yet. The read-only list of what it holds
    // is only offered once the game has written one.
    in-out property <bool> has_options: false;
    // What `options.txt` holds right now. Read-only: the game owns this file.
    in-out property <[SettingRow]> options: [];

    // Minimum heap in MiB.
    in-out property <int> jvm_min: 0;
    // Maximum heap in MiB.
    in-out property <int> jvm_max: 0;
    // Extra JVM arguments, space separated as the user typed them.
    in-out property <string> jvm_extra: "";
    // Path to a specific `java`, empty when the launcher may choose one.
    in-out property <string> java_path: "";

    // The saved instance's garbage collector preset, as `GcPreset`'s own serde token (e.g.
    // `"g1"`). Read back by the heap Save button, so a heap save never wipes a saved preset it
    // does not itself edit. Rust writes it from the probe's answer, so it is the preset as the
    // current Java runs it: a plain `"zgc"` saved before the runtime moved to Java 23 reads
    // back here as `"zgc_generational"`.
    in-out property <string> gc_token: "";
    // Presets the probed Java supports, in menu order, `GcPreset::Default` first. Empty
    // while `gc_loading` is true or the probe has not run yet.
    in-out property <[GcPresetRow]> gc_options: [];
    // `gc_options`' labels, index-parallel with it. A `ComboBox` model must be `[string]`,
    // so this exists purely for `gc_combo` to bind to; `gc_options` is what a row's token
    // and description are read from, same index.
    in-out property <[string]> gc_labels: [];
    // Which row of `gc_options` (and `gc_labels`) is selected.
    in-out property <int> gc_selected_index: 0;
    // One line naming the probed Java (e.g. "Java 21.0.4 from the Mojang runtime"), or
    // "Preparing Java…" while `gc_loading` is true.
    in-out property <string> gc_status: "";
    // True while the collector block is busy: from the start of every `load` until the probe
    // answers, whether it installs a runtime first or not, and again from a pick until that
    // pick is saved or refused. A refusal reads the block again, which clears it.
    in-out property <bool> gc_loading: false;
    // Non-empty, already-formatted "Unavailable: <preset> — <reason>" line when the saved
    // preset is not one the current Java supports. Empty otherwise.
    in-out property <string> gc_unavailable_reason: "";

    // A combo row was picked. Carries the chosen preset's token; saves immediately, with no
    // separate Save button, unlike the heap fields above.
    callback gc_pick(string /* token */);

    // Output of the running or last game, oldest first. Empty until a game runs: an
    // instance that has never been launched has written nothing.
    in-out property <[LogLine]> game_log: [];
    // Whether the log view follows new lines.
    in-out property <bool> autoscroll: true;
    // How many installed files have a newer version at their source.
    in-out property <int> update_count: 0;

    // The one-field prompt this screen owns, shown when a launch found no account and when
    // the instance is renamed.
    in-out property <bool> prompt_open: false;
    // What the open prompt is for: "offline" for the launch name, "rename" for the new name.
    // `src/screens/instance.rs` reads it back to decide what an accepted prompt does.
    in-out property <string> prompt_mode: "";
    // Headline of that prompt.
    in-out property <string> prompt_title: "Play offline";
    // Label above its field.
    in-out property <string> prompt_label: "Player name";
    // Label of its accepting button.
    in-out property <string> prompt_accept: "Launch";
    // What the user typed into it.
    in-out property <string> prompt_value: "";

    // Read this slug's instance from disk and fill every property above.
    callback load(string);
    // Empty every property above. `app.slint` calls this when the instance screen is shown
    // with no `App.current_slug`, so the screen shows an empty state rather than the last
    // instance that was open.
    callback clear();
    // Start the game.
    callback launch();
    // Stop the game: `Launcher::stop_instance` signals the child. The launch thread is what
    // reports the exit, so nothing else changes here.
    callback stop();
    // Install everything a launch needs, without starting the game.
    callback install();
    // Go back to the instance list.
    callback back();
    // Rename this instance: open the prompt with the current name in it.
    callback rename();
    // A tab was picked. Carries its index.
    callback set_tab(int);
    // A row's Enable/Disable button was pressed. Carries the project id and the new state.
    callback content_toggle(string /* project_id */, bool /* enabled */);
    // A row's Remove button was pressed. Carries the project id.
    callback content_remove(string);
    // Look for newer versions of everything installed.
    callback check_updates();
    // Install every update the last check found.
    callback apply_updates();
    // Open the content browser for this instance.
    callback add_content();
    // A hand-downloaded file was named. Carries the pending project id and the path typed.
    callback import_manual(string /* project_id */, string /* path */);
    // Set one raw `options.txt` override, from the Advanced editor. Carries the key and the
    // value. Everything the catalog knows is set through `SettingsEditorState` instead.
    callback override_set(string /* key */, string /* value */);
    // Save the JVM tab. Carries min MiB, max MiB, extra arguments, and the java path.
    callback jvm_save(int /* min */, int /* max */, string /* extra */, string /* java_path */);
    // Report where this instance's logs are written.
    callback open_log_folder();
    // The prompt was accepted. Carries the name typed; `prompt_mode` says what it is for.
    callback prompt_ok(string);
    // The prompt was dismissed.
    callback prompt_cancel();
}

// Everything the accounts screen, its name prompt, and the device-code dialog read and report.
//
// The screen lives inside an `if` in `app.slint`, so Rust cannot reach its properties. This
// global is the seam, the same way `InstanceState` is for the detail view:
// `src/screens/accounts.rs` binds it, and the screen reads it directly.
//
// Every property here starts empty: the account store is read when the screen is shown, and
// a sample row would be on screen until that read answered. The preview's rows live in
// `PreviewAccountsScreen`, at the end of this screen's file.
export global AccountsState {
    // Saved accounts, in the order the store holds them.
    in-out property <[AccountRow]> rows: [];
    // Whether a Microsoft client id is configured, which is what makes sign-in possible.
    in-out property <bool> msa_available: false;
    // Why sign-in is off, shown next to the disabled button. Empty while it is on.
    in-out property <string> msa_hint: "";
    // True while a store operation, a refresh, or a sign-in is running.
    in-out property <bool> busy: false;
    // One line about the last thing that happened here.
    in-out property <string> status: "";

    // Whether the device-code dialog is up.
    in-out property <bool> device_open: false;
    // The short code the user types on Microsoft's page. Empty until the code arrives.
    in-out property <string> device_code: "";
    // The page the user opens to enter that code.
    in-out property <string> device_uri: "";

    // Whether the offline-name prompt is up.
    in-out property <bool> prompt_open: false;
    // What the user typed into it.
    in-out property <string> prompt_value: "";

    // Whether the remove confirmation is up.
    in-out property <bool> confirm_open: false;
    // Body text of that confirmation.
    in-out property <string> confirm_text: "";

    // The screen was shown: read the account store and the Microsoft client id.
    callback open();
    // The Add offline button was pressed: ask for a name.
    callback add_offline();
    // The offline-name prompt was accepted. Carries the name typed.
    callback prompt_ok(string);
    // The offline-name prompt was dismissed.
    callback prompt_cancel();
    // Make one account the launch default. Carries its id.
    callback select(string);
    // A row's Remove button was pressed: ask first. Carries its id.
    callback remove(string);
    // The remove confirmation was accepted.
    callback confirm_yes();
    // The remove confirmation was dismissed.
    callback confirm_no();
    // Sign a saved Microsoft account in again from its stored refresh token. Carries its id.
    callback refresh(string);
    // Start a Microsoft sign-in and open the device-code dialog.
    callback sign_in();
    // Cancel the sign-in that dialog is showing.
    callback cancel_sign_in();
}

// Everything the settings screen reads and reports.
//
// The same seam as `AccountsState`, for `src/screens/settings.rs`. The two key fields are
// write-only on purpose: a saved key is shown as set or unset and never as its value.
//
// Every property here starts empty: the config is read when the screen is shown. The
// preview's values live in `PreviewSettingsScreen`, at the end of this screen's file.
export global SettingsState {
    // The app root in use right now.
    in-out property <string> root_path: "";
    // Root typed into the Change field, empty until the user types one.
    in-out property <string> new_root: "";
    // Maximum number of concurrent downloads.
    in-out property <int> parallel: 0;
    // Default minimum heap, in MiB.
    in-out property <int> jvm_min: 0;
    // Default maximum heap, in MiB.
    in-out property <int> jvm_max: 0;
    // Path to a specific `java`, empty when the launcher may choose one.
    in-out property <string> java_path: "";
    // Whether this build carries a CurseForge API key, from the config file or the environment.
    in-out property <bool> curseforge_enabled: false;
    // Whether a Microsoft client id is configured.
    in-out property <bool> msa_client_id_set: false;
    // What the user typed into the client id field. Cleared as soon as it is saved.
    in-out property <string> msa_client_id_input: "";
    // One line about the last thing that happened here.
    in-out property <string> status: "";
    // PASS/FAIL lines from the last source check, in check order.
    in-out property <[string]> verify_lines: [];
    // True while a save or a source check is running.
    in-out property <bool> busy: false;

    // The screen was shown: read the config.
    callback open();
    // Point the launcher at another app root. Carries the path typed.
    callback save_root(string);
    // Change the download concurrency. Carries the new count.
    callback save_downloads(int);
    // Save the JVM defaults. Carries min heap, max heap, and the java path, as typed.
    callback save_jvm(string /* min */, string /* max */, string /* java_path */);
    // Save the Microsoft client id. An empty string clears it.
    callback save_msa_client_id(string);
    // Set one raw `options.txt` default, from the Advanced editor. Carries the key and the
    // value. Everything the catalog knows is set through `SettingsEditorState` instead.
    callback default_set(string /* key */, string /* value */);
    // Check every configured source and the Mojang manifest. Talks to the network.
    callback verify_sources();
}
