import { LineEdit, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsEditorState, SettingsState } from "../state.slint";
import { Button } from "../components/button.slint";
import { Card } from "../components/card.slint";
import { Chooser } from "../components/chooser.slint";
import { SettingsEditor } from "../components/settings-editor.slint";

// Launcher-wide settings: root, downloads, JVM defaults, API keys, game defaults, and the
// source check.
//
// Pure layout. Every value comes from the [`SettingsState`] global and every action is
// reported through it, so `src/screens/settings.rs` is the only place that knows what any of
// this means. The heap fields are typed text, so they are held here and parsed in Rust.
export component SettingsScreen inherits Rectangle {
    // Minimum heap as typed, seeded from the saved value.
    property <string> min_text: SettingsState.jvm_min + "";
    // Maximum heap as typed, seeded from the saved value.
    property <string> max_text: SettingsState.jvm_max + "";
    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        Text {
            text: "Settings";
            color: Theme.text;
            font-size: Theme.font-size-h1;
            height: Theme.row-height;
            vertical-alignment: center;
        }

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Theme.gap;
                padding-right: Theme.pad;

                // App root. Changing it only writes the new path: nothing is moved.
                Card {
                    title: "App root";

                    Text {
                        text: "A new root is used the next time the launcher starts. Instances, "
                            + "caches, and accounts stay where they are; move them by hand if "
                            + "you want them in the new root.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }

                    root_chooser := Chooser {
                        label: "App root";
                        value: SettingsState.root_path;
                        status: SettingsState.status;
                        width: 100%;
                        choose => {
                            SettingsState.choose_root();
                        }
                    }
                }

                // Download concurrency.
                Card {
                    title: "Downloads";

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        Text {
                            text: "Parallel downloads";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        parallel_spin := SpinBox {
                            minimum: 1;
                            maximum: 32;
                            value: SettingsState.parallel;
                            width: 120px;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        parallel_apply_button := Button {
                            text: "Apply";
                            enabled: !SettingsState.busy;
                            clicked => {
                                SettingsState.save_downloads(parallel_spin.value);
                            }
                        }
                    }
                }

                // JVM defaults, used unless an instance overrides them.
                Card {
                    title: "Java defaults";

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        Text {
                            text: "Heap min";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        memory_min_field := LineEdit {
                            placeholder-text: "1024";
                            text <=> root.min_text;
                            width: 110px;
                        }

                        Text {
                            text: "Heap max";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        memory_max_field := LineEdit {
                            placeholder-text: "4096";
                            text <=> root.max_text;
                            width: 110px;
                        }

                        Text {
                            text: "MiB, or a size like 8G";
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        Text {
                            text: "Java path";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        java_path_field := LineEdit {
                            placeholder-text: "empty: let the launcher choose";
                            text <=> SettingsState.java_path;
                            horizontal-stretch: 1;
                        }

                        java_apply_button := Button {
                            text: "Apply";
                            enabled: !SettingsState.busy;
                            clicked => {
                                SettingsState.save_jvm(
                                    root.min_text, root.max_text, SettingsState.java_path);
                            }
                        }
                    }
                }

                // API keys. A saved key is never shown, only whether there is one.
                Card {
                    title: "Keys";

                    curseforge_status_text := Text {
                        text: SettingsState.curseforge_enabled
                            ? "CurseForge: enabled"
                            : "CurseForge: off (this build carries no key)";
                        color: Theme.text-muted;
                        font-size: Theme.font-size;
                        height: Theme.row-height;
                        vertical-alignment: center;
                        accessible-role: text;
                        accessible-label: self.text;
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        Text {
                            text: "Microsoft client id " + (SettingsState.msa_client_id_set
                                ? "<set>"
                                : "<unset>");
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }

                        msa_client_id_field := LineEdit {
                            placeholder-text: "paste a client id, or leave empty to clear";
                            input-type: password;
                            text <=> SettingsState.msa_client_id_input;
                            horizontal-stretch: 1;
                        }

                        msa_client_id_button := Button {
                            text: SettingsState.msa_client_id_input == "" ? "Clear" : "Save";
                            enabled: !SettingsState.busy;
                            clicked => {
                                SettingsState.save_msa_client_id(
                                    SettingsState.msa_client_id_input);
                            }
                        }
                    }

                    Text {
                        text: "A key set in the environment wins over the one saved here, and "
                            + "the value is never shown again once it is saved.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }
                }

                // `options.txt` keys written into every new instance.
                Card {
                    title: "Game settings";

                    Text {
                        text: "These are preseeded into every new instance. An instance that "
                            + "already has an options.txt keeps what the game wrote; set a "
                            + "value on that instance instead.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }

                    SettingsEditor { }
                }

                // The one thing on this screen that talks to the network, and only on click.
                Card {
                    title: "Sources";

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        Text {
                            text: "Check every configured source and the Mojang manifest.";
                            color: Theme.text-muted;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        verify_button := Button {
                            text: "Verify sources";
                            enabled: !SettingsState.busy;
                            clicked => {
                                SettingsState.verify_sources();
                            }
                        }
                    }

                    for line in SettingsState.verify_lines: Text {
                        text: line;
                        // Slint has no substring test, so the line carries its own verdict
                        // in its text: `PASS <source>` or `FAIL <source>: <error>`.
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            text: SettingsState.status;
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            height: Theme.row-height;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Preview only: `just ui-preview screens/settings.slint` renders this one, because a viewer
// with no `--component` shows the last exported component of the file.
//
// `SettingsState` and `SettingsEditorState` both start empty, so the screen on its own would
// preview with no root, no heap sizes and no settings rows. This component fills both with
// the sample values they used to carry as their defaults. Nothing in the app instantiates
// it, and it is the only place the editor's sample rows live — the instance screen's
// Settings tab mounts the same editor over the same global.
export component PreviewSettingsScreen inherits SettingsScreen {
    width: 1200px;
    height: 760px;

    init => {
        SettingsState.root_path = "/home/steve/.local/share/grid-craft-launcher";
        SettingsState.parallel = 8;
        SettingsState.jvm_min = 1024;
        SettingsState.jvm_max = 4096;
        SettingsState.msa_client_id_set = true;
        SettingsState.status = "Ready";
        SettingsEditorState.rows = [
            {
                key: "Video",
                label: "Video",
                group: "Video",
                control: "group",
                checked: true,
                choice_index: 3,
            },
            {
                key: "renderDistance",
                label: "Render Distance",
                group: "Video",
                control: "slider",
                value: "16",
                number: 16,
                minimum: 2,
                maximum: 32,
                step: 1,
                decimals: 0,
                display_decimals: 0,
                unit: "",
                source: "preseed",
                inherited: false,
                resettable: true,
            },
            {
                key: "fov",
                label: "Field of View",
                group: "Video",
                control: "slider",
                value: "0.0",
                number: 70,
                minimum: 30,
                maximum: 110,
                step: 1,
                decimals: 3,
                display_decimals: 0,
                unit: "\u{b0}",
                source: "default",
                inherited: true,
                resettable: false,
            },
            {
                key: "fullscreen",
                label: "Fullscreen",
                group: "Video",
                control: "toggle",
                value: "false",
                checked: false,
                source: "default",
                inherited: true,
                resettable: false,
            },
            {
                key: "graphicsMode",
                label: "Graphics",
                group: "Video",
                control: "choice",
                value: "1",
                choices: ["Fast", "Fancy", "Fabulous"],
                choice_index: 1,
                source: "default",
                inherited: true,
                resettable: false,
            },
        ];
    }
}
