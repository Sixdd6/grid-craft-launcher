import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Button } from "button.slint";

// A search field with a clear button. `accepted` fires on Enter, `edited` on every keystroke.
//
// Down is not a text key, so the field hands it back: `moved_down` lets the owner send the
// keyboard to the list under the box without the box ever taking focus by itself.
export component SearchBox inherits Rectangle {
    in property <string> placeholder: "Search";
    in-out property <string> text;
    callback accepted(string);
    callback edited(string);
    // The user pressed Down in the field, which means "take me to the list".
    callback moved_down();

    height: Theme.row-height;
    min-width: 200px;

    HorizontalLayout {
        spacing: Theme.gap;

        edit := LineEdit {
            placeholder-text: root.placeholder;
            text <=> root.text;
            accepted(value) => {
                root.accepted(value);
            }
            edited(value) => {
                root.edited(value);
            }
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.moved_down();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
        }

        Button {
            text: "clear";
            enabled: root.text != "";
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}
