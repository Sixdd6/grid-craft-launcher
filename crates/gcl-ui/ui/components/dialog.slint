import { Theme } from "../theme.slint";
import { Button } from "button.slint";

// Modal overlay with a titled panel. Body content comes from children.
//
// The panel is wrapped in a `FocusScope`, which does two things. It takes focus when the
// dialog opens, so the keyboard is inside the modal and not on the screen behind it. And it
// is the ancestor of every field a caller puts in `@children`, so Escape typed in a
// `LineEdit` bubbles up to here and closes the dialog.
export component Dialog inherits Rectangle {
    in property <bool> open: true;
    in property <string> title: "Title";
    in property <string> close-text: "Close";
    // Set this to add a second, affirming button next to the closing one.
    in property <string> confirm-text: "";
    // Whether that affirming button can be pressed.
    in property <bool> confirm-enabled: true;
    // Paints the affirming button in the danger color, for a destructive action.
    in property <bool> danger: false;
    // Set this when the body starts with a text field the user should be typing in.
    //
    // Slint gives no way to reach into `@children` and focus the first field from here, so the
    // caller focuses its own field and this only says "do not take the focus away from it".
    // Escape still closes the dialog: the scope below is that field's ancestor, so a key the
    // field rejects bubbles up to it.
    in property <bool> focus-first-field: false;
    callback close();
    callback confirm();

    visible: root.open;
    background: Colors.black.with-alpha(0.55);
    forward-focus: keys;

    // A closed dialog stays mounted but must never hold the keyboard. A dialog whose body
    // starts with a field leaves the focus to that field instead.
    changed open => {
        if (root.open && !root.focus-first-field) {
            keys.focus();
        }
    }

    // Click outside the panel closes the dialog.
    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: min(root.width - 4 * Theme.pad, Theme.dialog-width);
        height: panel.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;

        // Swallows clicks so they do not reach the overlay behind the panel.
        TouchArea { }

        keys := FocusScope {
            enabled: root.open;
            width: 100%;
            height: 100%;

            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            panel := VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-size-title;
                }

                @children

                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.gap;

                    cancel_button := Button {
                        text: root.close-text;
                        // The closing button leads only while it is the sole action.
                        kind: root.confirm-text == "" ? "primary" : "secondary";
                        clicked => {
                            root.close();
                        }
                    }

                    if root.confirm-text != "": confirm_button := Button {
                        text: root.confirm-text;
                        kind: root.danger ? "danger" : "primary";
                        enabled: root.confirm-enabled;
                        clicked => {
                            root.confirm();
                        }
                    }
                }
            }
        }
    }
}
