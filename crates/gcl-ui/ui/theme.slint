// Design tokens. Dark first. Every screen reads colors, spacing, and font sizes from here,
// never from literals.
export global Theme {
    // Surfaces, darkest to lightest.
    out property <color> bg: #121417;
    out property <color> surface: #1b1e23;
    out property <color> surface-raised: #23272e;
    out property <color> surface-hover: #2b3038;
    // The odd-row tint in a dense list, one step off `surface`: subtle enough that a row's
    // own hover and selection colors still read clearly over it.
    out property <color> surface-alt: #1f2228;
    out property <color> border: #2e333b;

    // Text.
    out property <color> text: #e6e8eb;
    out property <color> text-muted: #9aa1ab;

    // Accents and status.
    out property <color> accent: #5ac8fa;
    out property <color> accent-text: #0b1014;
    out property <color> danger: #ff5c5c;
    out property <color> success: #5ad18a;
    out property <color> warning: #f0b429;
    out property <color> focus: #7fd8ff;

    // Metrics.
    out property <length> radius: 6px;
    out property <length> gap: 8px;
    out property <length> pad: 12px;
    out property <length> row-height: 34px;
    out property <length> rail-width: 200px;
    // Height of the collapsed task strip at the bottom of the window.
    out property <length> strip-height: 34px;
    // Height of a determinate progress bar.
    out property <length> bar-height: 6px;
    // Widest a modal panel is allowed to get.
    out property <length> dialog-width: 520px;
    // Widest a `wide` modal panel gets, for a body with prose that needs room to wrap.
    out property <length> dialog-width-wide: 900px;
    // Width of one toast in the stack over the shell.
    out property <length> toast-width: 360px;
    // Smallest a name column in a dense row may get before it elides.
    out property <length> label-width: 120px;
    // Width of a one-word status column, wide enough for the longest of them.
    out property <length> status-width: 56px;
    // Width of a determinate bar sitting inside a row.
    out property <length> bar-width: 200px;
    // Width of the colored edge that says what kind a toast is.
    out property <length> accent-stripe: 3px;
    // Side of a project icon tile in a search row. The details header shows no icon.
    out property <length> icon-size: 48px;
    // Width of a search row's Author column.
    out property <length> col-author: 140px;
    // Width of a search row's Downloads column, right-aligned.
    out property <length> col-downloads: 100px;
    // Width of a search row's Last updated column.
    out property <length> col-date: 110px;
    // Width of a search row's button column: the primary button, plus the state line
    // beneath it.
    out property <length> col-action: 170px;

    // Type scale.
    out property <length> font-size: 14px;
    out property <length> font-size-small: 12px;
    out property <length> font-size-title: 20px;
    out property <length> font-size-h1: 24px;

    // Font weight and family, for a description block styled by heading level or kind.
    out property <int> font-weight-regular: 400;
    out property <int> font-weight-bold: 700;
    out property <string> font-family-mono: "monospace";
}
