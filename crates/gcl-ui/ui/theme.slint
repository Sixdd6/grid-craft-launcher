// Design tokens. Dark first. Every screen reads colors, spacing, and font sizes from here,
// never from literals. See docs/design/ui-standard.md for the standard this file implements.
export global Theme {
    // Surfaces, darkest to lightest.
    out property <color> bg: #07070f;
    out property <color> surface: #14141f;
    out property <color> surface-raised: #1c1c2b;
    out property <color> surface-hover: #ffffff11;
    // The odd-row tint in a dense list, one step off `surface`: subtle enough that a row's
    // own hover and selection colors still read clearly over it.
    out property <color> surface-alt: #ffffff08;
    out property <color> border: #22223a;

    // Text.
    out property <color> text: #ffffff;
    out property <color> text-muted: #c8c8dc;

    // Accents and status.
    out property <color> accent: #8b74e8;
    // Hover tint for a primary button and a `ComboBox` debounce highlight.
    out property <color> accent-hover: #a18fff;
    // Pressed tint for a primary button.
    out property <color> accent-pressed: #6043c8;
    out property <color> accent-text: #ffffff;
    out property <color> danger: #ff5050;
    out property <color> success: #4ade80;
    out property <color> warning: #fbbf24;
    out property <color> focus: accent-hover;
    // The one shadow level, on dialogs and toasts only: black at 35 % alpha.
    out property <color> shadow-color: #00000059;
    // The dialog backdrop: black at 55 % alpha.
    out property <color> backdrop: #0000008c;

    // Metrics.
    // Control radius: buttons, fields, combo boxes. Kept as `radius` so existing files
    // compile; new code names the specific radius token below.
    out property <length> radius: 4px;
    // Radius for chips, badges, and icon buttons.
    out property <length> radius-chip: 6px;
    // Radius for list rows, rail entries, and toasts.
    out property <length> radius-row: 8px;
    // Radius for cards and dialog panels.
    out property <length> radius-card: 14px;
    out property <length> gap: 8px;
    out property <length> pad: 12px;
    out property <length> row-height: 34px;
    out property <length> rail-width: 220px;
    // Height of the collapsed task strip at the bottom of the window.
    out property <length> strip-height: 34px;
    // Height of a determinate progress bar.
    out property <length> bar-height: 6px;
    // Widest a modal panel is allowed to get.
    out property <length> dialog-width: 520px;
    // Widest a `wide` modal panel gets, for a body with prose that needs room to wrap.
    out property <length> dialog-width-wide: 900px;
    // Width of one toast in the stack over the shell.
    out property <length> toast-width: 360px;
    // Smallest a name column in a dense row may get before it elides.
    out property <length> label-width: 120px;
    // Width of a one-word status column, wide enough for the longest of them.
    out property <length> status-width: 56px;
    // Width of a determinate bar sitting inside a row.
    out property <length> bar-width: 200px;
    // Width of the colored edge that says what kind a toast is, and of a `TabBar`'s active
    // underline.
    out property <length> accent-stripe: 3px;
    // Blur radius of the one shadow level, on dialogs and toasts.
    out property <length> shadow-blur: 32px;
    // Vertical offset of the one shadow level.
    out property <length> shadow-offset-y: 12px;
    // Smallest a `SearchBox` may get before its field starts to crowd the toolbar.
    out property <length> search-min-width: 240px;
    // Side of a project icon tile in a search row. The details header shows no icon.
    out property <length> icon-size: 48px;
    // Gap between the columns of a search row and the header above it. Wider than
    // `gap`, because the Downloads column is right-aligned and would otherwise end one
    // `gap` short of the Last updated label next to it.
    out property <length> col-gap: 16px;
    // Width of a search row's Author column.
    out property <length> col-author: 140px;
    // Width of a search row's Downloads column, right-aligned.
    out property <length> col-downloads: 100px;
    // Width of a search row's Last updated column.
    out property <length> col-date: 110px;
    // Width of a search row's button column: the primary button, plus the state line
    // beneath it.
    out property <length> col-action: 170px;
    // Padding around a screen's content, inside the rail.
    out property <length> pad-screen: 24px;
    // Horizontal padding inside a rail entry.
    out property <length> pad-entry: 10px;
    // Gap between controls in a screen's toolbar row (search box, filters).
    out property <length> gap-toolbar: 12px;

    // Motion.
    // Duration of a hover or selection tint change.
    out property <duration> motion-fast: 150ms;
    // Duration of a panel open/close or a toast entering.
    out property <duration> motion-base: 220ms;

    // Type scale.
    out property <length> font-size: 13px;
    out property <length> font-size-small: 11px;
    out property <length> font-size-title: 20px;
    out property <length> font-size-h1: 24px;
    // Group heading size: paired with `font-weight-medium`-and-up styling, uppercase,
    // 0.1em letter-spacing, set by the caller.
    out property <length> font-size-section: 10px;

    // Font weight and family, for a description block styled by heading level or kind.
    out property <int> font-weight-regular: 400;
    // Weight for titles, the active rail entry, toast text, and chips.
    out property <int> font-weight-medium: 600;
    out property <int> font-weight-bold: 700;
    out property <string> font-family-mono: "monospace";
}
