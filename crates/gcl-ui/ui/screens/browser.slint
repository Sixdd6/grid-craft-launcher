import { ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Shell } from "../state.slint";
import { SearchRow } from "../types.slint";
import { Button } from "../components/button.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ListRow } from "../components/list-row.slint";
import { SearchBox } from "../components/search-box.slint";

// Everything the content browser reads and reports.
//
// The screen lives inside an `if` in `app.slint`, so Rust cannot reach its properties. This
// global is the seam, the same way `InstancesState` is for the list: `src/screens/browser.rs`
// binds it, and the screen reads it directly.
//
// Two lists are paired with an index each: `source_labels`/`source_index` and
// `target_labels`/`target_index`. Rust owns the ids behind those labels, so the screen only
// ever reports which row was picked. `kind_labels` is rebuilt per source, because a source
// that cannot serve a kind must not offer it.
//
// Every property here starts empty, apart from the two label lists that are fixed choices
// rather than data. `src/screens/browser.rs` fills the rest when the screen is shown, so
// nothing the user did not ask for is ever on screen. The sample hits the preview needs
// live in `PreviewBrowserScreen`, at the end of this file.
export global BrowserState {
    // What the user typed into the search box. The modpack kind reads it twice over: Search
    // looks it up as text, and the Install modpack button takes it as a project id or slug.
    in-out property <string> query: "";
    // Sources that are enabled, in ComboBox order.
    in-out property <[string]> source_labels: [];
    // Index into `source_labels`.
    in-out property <int> source_index: 0;
    // Content kinds the chosen source serves, in ComboBox order.
    in-out property <[string]> kind_labels: [
        "mod", "resourcepack", "shader", "datapack", "modpack"
    ];
    // Index into `kind_labels`.
    in-out property <int> kind_index: 0;
    // Minecraft version filter, empty for any.
    in-out property <string> minecraft: "";
    // Minecraft versions the ComboBox offers, `"any"` first. Rust fills the rest in `open()`
    // from the Mojang manifest, so the combo shows only `["any", <prefilled version>]` until
    // that job answers.
    in-out property <[string]> minecraft_options: [];
    // Index into `minecraft_options`, kept in step with `minecraft` the same way `loader`
    // and `loader_index` are: the ComboBox only moves its selection through `current-index`,
    // and `minecraft` is what the search actually reads.
    in-out property <int> minecraft_index: 0;
    // Loader filter: `any`, or one loader slug. Rust reads this one; the ComboBox drives
    // `loader_index`, and `screens/browser.rs` keeps the two in step.
    in-out property <string> loader: "";
    // Index into `loader_options`. A ComboBox only moves its selection through
    // `current-index`, so this, not `loader`, is what the control binds to.
    in-out property <int> loader_index: 0;
    // Loader filters the ComboBox offers. `any` means the search is not filtered by loader.
    in-out property <[string]> loader_options: ["any", "fabric", "quilt", "forge", "neoforge"];

    // The Minecraft version the latest-version job actually resolved each row against, as
    // `fetch_latest` (`src/screens/browser.rs`) last saw it — never the live `minecraft`
    // filter field above, which a user can keep editing after that job has already run.
    // `target_label()` reads this pair, not the filter, so the column header over the
    // buttons never claims a target the rows on screen were not actually checked against.
    in-out property <string> latest_minecraft: "";
    // The loader the latest-version job actually resolved each row against, `any` for none.
    in-out property <string> latest_loader: "";

    // Slug of the instance an Add installs into, empty when none is chosen yet.
    in-out property <string> target_slug: "";
    // Display name of that instance, for the button label.
    in-out property <string> target_name: "";
    // Every instance that could be the target, in ComboBox order. Only used when the browser
    // was opened from the rail, with no instance already on screen.
    in-out property <[string]> target_labels: [];
    // Index into `target_labels`, or -1 when nothing is chosen.
    in-out property <int> target_index: -1;
    // Whether the target is already decided, which it is when the browser was opened from
    // an instance's detail screen. The rail clears it, and the target ComboBox is shown
    // whenever it is false.
    in-out property <bool> fixed_target: false;

    // The current page of hits, in the source's own order.
    in-out property <[SearchRow]> rows: [];
    // The current page of modpack hits, shown by the modpack kind only. A pack is installed
    // as its own instance, so these rows are kept apart from `rows`: the two lists have
    // different buttons and only one of them is ever on screen.
    in-out property <[SearchRow]> pack_rows: [];
    // Which page is shown, counting from zero.
    in-out property <int> page: 0;
    // How many hits one page asks for.
    in-out property <int> page_size: 20;
    // Whether the source has hits past this page.
    in-out property <bool> has_more: false;
    // True while a search is running. Gates the results list, its header, and the keyboard
    // scope: nothing else may unmount them.
    in-out property <bool> loading: false;
    // True while an install (`add`, `pick_world`'s world lookup, or `install_pack`) is
    // running. Disables the action buttons and feeds the status line; it never gates the
    // results list, its header, or the keyboard scope, so a row an install is running on
    // stays on screen.
    in-out property <bool> busy: false;
    // One line about the last thing that happened here.
    in-out property <string> status: "";
    // Set by `ProjectState.back()` just before it returns here, so `open()` (which every
    // navigation to this screen runs) knows this page of hits still belongs to the query on
    // screen and must not clear it. Rust clears the flag back to false once it has read it.
    in-out property <bool> returning: false;

    // Path typed into the modpack panel's "From file" field.
    in-out property <string> pack_path: "";
    // Whether the new-instance name prompt is up, for a modpack install.
    in-out property <bool> name_open: false;
    // What the user typed into it.
    in-out property <string> name_value: "";
    // Whether the world chooser is up, for a data pack install.
    in-out property <bool> choice_open: false;
    // Worlds that chooser offers.
    in-out property <[string]> choice_options: [];
    // Index into `choice_options`.
    in-out property <int> choice_index: 0;

    // The screen was shown: load the sources, the instances, and the prefilled filters.
    callback open();
    // Run the search the filters describe, from page zero.
    callback search();
    // Search the chosen source for modpacks, from page zero.
    callback search_packs();
    // Show the next page of the same search.
    callback next_page();
    // Show the previous page of the same search.
    callback prev_page();
    // A row's Add button was pressed. Carries the project id and the row's own kind, which
    // is what decides how it installs: the Type selector can be changed after a search, and
    // the rows on screen keep the kind they were found with.
    callback add(string /* project_id */, string /* kind */);
    // A modpack is to be installed as a new instance. Carries the project id or slug, and
    // the row's title, which is what the name prompt prefills with when it is not empty.
    callback install_pack(string /* project_id */, string /* title */);
    // A modpack archive on disk is to be imported as a new instance. Carries its path.
    callback install_pack_file(string /* path */);
    // The source ComboBox changed. Carries its new index.
    callback set_source(int);
    // The kind ComboBox changed. Carries its new index.
    callback set_kind(int);
    // The target ComboBox changed. Carries its new index.
    callback set_target(int);
    // The loader ComboBox changed. Carries its new index into `loader_options`.
    callback set_loader(int);
    // The Minecraft version ComboBox settled on an index, 500ms after the last change: sets
    // `minecraft` (`"any"` maps to `""`) and `minecraft_index`, then runs the search.
    callback set_minecraft(int);
    // A data pack row's Add button was pressed: ask which world it goes into. Carries the
    // project id and the row's own kind.
    callback pick_world(string /* project_id */, string /* kind */);
    // A row's Update button was pressed: install `version_id` (its own `latest_id`) over
    // the file already there, then refresh that row's install state. Carries the project
    // id, the row's own kind, and the version to install.
    callback update(string /* project_id */, string /* kind */, string /* version_id */);
    // The world chooser was accepted. Carries the world picked.
    callback choice_ok(string /* world */);
    // The world chooser was dismissed.
    callback choice_cancel();
    // The new-instance name prompt was accepted. Carries the name typed.
    callback name_ok(string);
    // The new-instance name prompt was dismissed.
    callback name_cancel();
}

// The content browser: filters on top, one page of hits under them, a pager at the bottom.
//
// Pure layout. Every value comes from [`BrowserState`] and every action is reported through
// it, so `src/screens/browser.rs` is the only place that knows what any of this means.
export component BrowserScreen inherits Rectangle {
    // Result row the keyboard is on, or -1 while nothing is chosen. Arrow keys move it and
    // Enter runs the same action as the row's primary button.
    in-out property <int> selected: -1;

    // The index `mc_combo` last reported, held until `mc_commit` fires: a ComboBox reports
    // every arrow step, not only the value the user settles on.
    property <int> pending_minecraft: 0;
    // How long `mc_combo` waits after the last change before it commits.
    property <duration> commit_delay: 500ms;

    // A row's title was clicked: open its project details. Carries the row's own download
    // count and author, already formatted, since `Launcher::project_details` answers with
    // neither of its own. `app.slint` wires this to `ProjectState.open` and `App.navigate`,
    // because `BrowserScreen` cannot reach either global itself (`app.slint` imports this
    // file, so the reverse import would cycle).
    callback open_project(string /* source */, string /* project_id */, string /* downloads */, string /* author */);

    // Runs whichever search the chosen kind means: modpacks are a search of their own,
    // because they are not content and never come back from the content search.
    function run_search() {
        if (root.modpack_mode) {
            BrowserState.search_packs();
        } else {
            BrowserState.search();
        }
    }

    // A result row's primary action: install a modpack, ask which world a data pack goes
    // into, and add anything else straight to the target instance. The button and the Enter
    // key both come through here, so the two can never drift apart.
    function activate(project_id: string, kind: string, title: string) {
        if (kind == "modpack") {
            BrowserState.install_pack(project_id, title);
        } else if (kind == "datapack") {
            BrowserState.pick_world(project_id, kind);
        } else {
            BrowserState.add(project_id, kind);
        }
    }

    // A result row's `row_install` button, and Enter on the selected row: Update over an
    // older install, nothing over an up-to-date one (the button is disabled there), and
    // `activate` for everything else. One seam so the button and the keyboard never drift
    // apart on what "older" or "installed" means.
    function row_primary_action(project_id: string, kind: string, title: string, state: string, latest_id: string) {
        if (kind != "modpack" && state == "installed") {
            return;
        }
        if (kind != "modpack" && state == "older") {
            BrowserState.update(project_id, kind, latest_id);
        } else {
            root.activate(project_id, kind, title);
        }
    }

    // The keyboard version. It repeats the button's `enabled` rule, so Enter does nothing
    // where the button would be greyed out.
    //
    // In `modpack_mode`, the selection runs over `BrowserState.pack_rows` instead, and Enter
    // opens the selected pack's details the same way clicking its row does: a pack is
    // installed as its own instance, not added to one, so there is no primary action to
    // repeat here, only `open_project`.
    function activate_selected() {
        if (root.modpack_mode) {
            if (root.selected >= 0 && root.selected < BrowserState.pack_rows.length) {
                root.open_project(
                    BrowserState.pack_rows[root.selected].source,
                    BrowserState.pack_rows[root.selected].project_id,
                    BrowserState.pack_rows[root.selected].downloads,
                    BrowserState.pack_rows[root.selected].author,
                );
            }
            return;
        }
        if (root.selected >= 0 && root.selected < BrowserState.rows.length
            && !BrowserState.loading && !BrowserState.busy
            && (BrowserState.rows[root.selected].kind == "modpack"
                || (root.has_target && BrowserState.rows[root.selected].state != "installed"
                    && BrowserState.rows[root.selected].state != "none"))) {
            root.row_primary_action(
                BrowserState.rows[root.selected].project_id,
                BrowserState.rows[root.selected].kind,
                BrowserState.rows[root.selected].title,
                BrowserState.rows[root.selected].state,
                BrowserState.rows[root.selected].latest_id,
            );
        }
    }

    // How many rows the keyboard scope currently steers: `pack_rows` in `modpack_mode`, the
    // content `rows` otherwise. Up/Down/Home/End/PageUp/PageDown all clamp to this.
    function result_count() -> int {
        return root.modpack_mode ? BrowserState.pack_rows.length : BrowserState.rows.length;
    }

    // "1.20.1 fabric", or empty when the target the latest-version job resolved against
    // named no Minecraft version or no loader. Reads `latest_minecraft`/`latest_loader`,
    // which is what that job actually ran with, not the filter fields: a user can keep
    // editing `minecraft`/`loader` after the search has already answered, and the header
    // must keep naming the target the rows were really checked against until the next
    // search or target change re-resolves them.
    //
    // It is said once, in the column header over the buttons, and never in a row: a row's
    // state line is one short phrase in a 170 px column, and the target repeated on every
    // row of the page pushed the version number itself out of view.
    function target_label() -> string {
        return (BrowserState.latest_minecraft != "" && BrowserState.latest_loader != ""
            && BrowserState.latest_loader != "any")
            ? BrowserState.latest_minecraft + " " + BrowserState.latest_loader
            : "";
    }

    // The line `row_state_text` shows under a row's button, short enough to fit the button
    // column without eliding: "Checking…" while the latest-version job has not answered for
    // this row yet, "Could not check" when it answered with nothing usable, "No version"
    // when nothing at the source fits the target, "Latest <n>" when the target does not have
    // it, "Installed <n>" when it has the newest one, and "Installed <n> ↑" when the copy it
    // has is behind — the arrow is what says an Update is waiting, and the number stays the
    // installed one, so the line never changes width when a row goes from installed to
    // older. Which target all of this is about is said once, in the column header.
    //
    // A row starts at state "unknown" with no latest number, and that is the one that reads
    // "Checking…". `InstallState::Unknown` — the install-state lookup itself failed — comes
    // back as "unknown" too, but with the latest version already resolved, so the number is
    // what tells the two apart. Without that a row whose lookup failed would say "Checking…"
    // for as long as it is on screen.
    function row_state_text(state: string, latest_number: string, installed_number: string) -> string {
        if (state == "unknown") {
            return latest_number == "" ? "Checking…" : "Could not check";
        }
        if (state == "none") {
            return "No version";
        }
        if (state == "installed") {
            return "Installed " + installed_number;
        }
        if (state == "older") {
            return "Installed " + installed_number + " ↑";
        }
        return "Latest " + latest_number;
    }

    // The kind the filters name, empty when the source offers none.
    property <string> kind_name: BrowserState.kind_index >= 0
        && BrowserState.kind_index < BrowserState.kind_labels.length
        ? BrowserState.kind_labels[BrowserState.kind_index]
        : "";
    // A modpack is not content: it is imported as its own instance, and no source search
    // returns one, so that kind swaps the results list for an install-by-id panel.
    property <bool> modpack_mode: root.kind_name == "modpack";
    // Whether an Add has somewhere to install into.
    property <bool> has_target: BrowserState.target_slug != "";

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // Header: title, the search field, and the button that runs the search.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            Text {
                text: "Browse";
                color: Theme.text;
                font-size: Theme.font-size-h1;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            search_box := SearchBox {
                placeholder: root.modpack_mode
                    ? "Search modpacks, or type an id or slug"
                    : "Search Modrinth or CurseForge";
                text <=> BrowserState.query;
                horizontal-stretch: 1;
                moved_down => {
                    keys.focus();
                }
                accepted(text) => {
                    root.run_search();
                }
            }

            search_button := Button {
                text: "Search";
                kind: "primary";
                enabled: !BrowserState.loading && !BrowserState.busy;
                clicked => {
                    root.run_search();
                }
            }
        }

        // Filters: source, kind, Minecraft version, loader, and the target instance.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            Text {
                text: "Source";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            source_combo := ComboBox {
                width: 130px;
                model: BrowserState.source_labels;
                current-index: BrowserState.source_index;
                enabled: BrowserState.source_labels.length > 1;
                selected => {
                    BrowserState.set_source(self.current-index);
                }
            }

            Text {
                text: "Type";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            kind_combo := ComboBox {
                width: 140px;
                model: BrowserState.kind_labels;
                current-index: BrowserState.kind_index;
                selected => {
                    BrowserState.set_kind(self.current-index);
                }
            }

            Text {
                text: "Minecraft";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            mc_combo := ComboBox {
                width: 140px;
                model: BrowserState.minecraft_options;
                // Two-way: `ComboBoxBase` assigns `current-index` itself (`reset-current`,
                // on a model change and on `select()`), which severs a plain one-way binding
                // the first time either happens. `<=>` is what lets a later
                // `BrowserState.minecraft_index` write from Rust — a target change, or
                // `load_minecraft_options` answering — still reach the widget afterwards.
                current-index <=> BrowserState.minecraft_index;
                selected => {
                    // A ComboBox reports every arrow step, not only the value the user
                    // settles on, so this only holds the pending index until `mc_commit`
                    // fires — the same debounce shape `SettingRow`'s choice combo uses.
                    root.pending_minecraft = self.current-index;
                    mc_commit.running = true;
                    mc_commit.restart();
                }
            }

            mc_commit := Timer {
                interval: root.commit_delay;
                running: false;
                triggered => {
                    self.running = false;
                    BrowserState.set_minecraft(root.pending_minecraft);
                }
            }

            Text {
                text: "Loader";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            loader_combo := ComboBox {
                width: 120px;
                model: BrowserState.loader_options;
                // Two-way, the same reason `mc_combo` is: `ComboBoxBase` assigns
                // `current-index` itself and a one-way binding does not survive that.
                current-index <=> BrowserState.loader_index;
                selected => {
                    BrowserState.set_loader(self.current-index);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // A modpack becomes its own instance, so it has no target to choose.
            if !BrowserState.fixed_target && !root.modpack_mode: Text {
                text: "Add to";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            if !BrowserState.fixed_target && !root.modpack_mode: target_combo := ComboBox {
                width: 200px;
                model: BrowserState.target_labels;
                // Two-way, the same reason `mc_combo` is.
                current-index <=> BrowserState.target_index;
                enabled: BrowserState.target_labels.length > 0;
                selected => {
                    BrowserState.set_target(self.current-index);
                }
            }
        }

        // Modpack install panel: the two ways to name a pack the search did not find.
        // It gives up the spare room as soon as there are results to show under it.
        if root.modpack_mode: Rectangle {
            vertical-stretch: BrowserState.pack_rows.length > 0 ? 0 : 1;
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                alignment: center;
                padding: Theme.pad;
                spacing: Theme.gap;

                Text {
                    text: "Install a modpack";
                    color: Theme.text;
                    font-size: Theme.font-size-title;
                    horizontal-alignment: center;
                }

                Text {
                    text: "A modpack becomes its own instance, so it is not added to one. "
                        + "Press Search to list packs, or type a project id or slug above "
                        + "and press Install modpack.";
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: center;

                    install_pack_button := Button {
                        text: "Install modpack";
                        kind: "primary";
                        enabled: BrowserState.query != "" && !BrowserState.loading;
                        clicked => {
                            // Typed by hand, so there is no title: the prompt falls back
                            // to the id.
                            BrowserState.install_pack(BrowserState.query, "");
                        }
                    }
                }

                Text {
                    text: "Or import a .mrpack or CurseForge zip you already have.";
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.gap;
                    height: Theme.row-height;

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    pack_path_field := LineEdit {
                        placeholder-text: "Path to the modpack archive";
                        text <=> BrowserState.pack_path;
                        width: 360px;
                        accepted(path) => {
                            BrowserState.install_pack_file(path);
                        }
                    }

                    install_file_button := Button {
                        text: "Install from file";
                        enabled: BrowserState.pack_path != "" && !BrowserState.loading;
                        clicked => {
                            BrowserState.install_pack_file(BrowserState.pack_path);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        // Modpack results: one row per pack, each installed as its own new instance. The
        // header names the same five columns the content rows use, so a pack list reads the
        // same way a content list does.
        if root.modpack_mode && BrowserState.pack_rows.length > 0: pack_results_header := Rectangle {
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                // The same gap the rows below set on their `ListRow`, so a label sits over
                // its own column.
                spacing: Theme.col-gap;

                Rectangle { width: Theme.icon-size; horizontal-stretch: 0; }

                Text {
                    text: "Name";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "Author";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-author;
                    horizontal-stretch: 0;
                }

                Text {
                    text: "Downloads";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-downloads;
                    horizontal-alignment: right;
                    horizontal-stretch: 0;
                }

                Text {
                    text: "Last updated";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-date;
                    horizontal-stretch: 0;
                }

                Rectangle { width: Theme.col-action; horizontal-stretch: 0; }
            }
        }

        if root.modpack_mode && BrowserState.pack_rows.length > 0: ListView {
            vertical-stretch: 1;
            width: 100%;

            for row[i] in BrowserState.pack_rows: pack_row := ListRow {
                title: row.title;
                column-spacing: Theme.col-gap;
                // Content-driven, same as `row_open` above: `pack_layout`'s preferred height
                // already reflects however many lines the wrapped title takes.
                height: max(pack_layout.preferred-height, pack_action.preferred-height);
                selected: i == root.selected;
                alt: mod(i, 2) == 1;
                clicked => {
                    // Clicking anywhere on the row but a button opens the details, the same
                    // as `row_open` above. Clicking a row is also how the keyboard gets
                    // here: the scope never grabs focus on its own.
                    keys.focus();
                    root.selected = i;
                    root.open_project(row.source, row.project_id, row.downloads, row.author);
                }

                Rectangle {
                    y: Theme.gap;
                    width: Theme.icon-size;
                    height: Theme.icon-size;
                    horizontal-stretch: 0;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    if row.icon.width > 0: Image {
                        source: row.icon;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }

                pack_layout := VerticalLayout {
                    padding-top: Theme.gap;
                    padding-bottom: Theme.gap;
                    spacing: Theme.gap / 2;
                    horizontal-stretch: 1;

                    // Not interactive on its own: it carries the accessible action for a
                    // screen reader, the same shape `row_title` uses above. Clicking
                    // anywhere on the row, including here, opens details through
                    // `pack_row`'s own `clicked` above.
                    pack_title := Rectangle {
                        height: pack_title_text.preferred-height;

                        accessible-role: button;
                        accessible-label: row.title;
                        accessible-action-default => {
                            keys.focus();
                            root.selected = i;
                            root.open_project(row.source, row.project_id, row.downloads, row.author);
                        }

                        pack_title_text := Text {
                            text: row.title;
                            color: Theme.text;
                            font-size: Theme.font-size;
                            horizontal-alignment: left;
                            width: 100%;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: row.description;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        overflow: elide;
                    }
                }

                Text {
                    text: row.author;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    width: Theme.col-author;
                    overflow: elide;
                }

                Text {
                    text: row.downloads;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 0;
                    width: Theme.col-downloads;
                }

                Text {
                    text: row.updated;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    width: Theme.col-date;
                }

                pack_action := VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    width: Theme.col-action;

                    pack_install_button := Button {
                        text: "Install";
                        kind: "primary";
                        enabled: !BrowserState.loading;
                        clicked => {
                            BrowserState.install_pack(row.project_id, row.title);
                        }
                    }
                }
            }
        }

        if root.modpack_mode && BrowserState.loading: Text {
            text: "Searching modpacks…";
            color: Theme.text-muted;
            font-size: Theme.font-size;
            height: Theme.row-height;
            vertical-alignment: center;
        }

        if !root.modpack_mode && BrowserState.loading: Text {
            text: "Searching…";
            color: Theme.text-muted;
            font-size: Theme.font-size;
            height: Theme.row-height;
            vertical-alignment: center;
        }

        if !root.modpack_mode && !BrowserState.loading && BrowserState.rows.length == 0: EmptyState {
            vertical-stretch: 1;
            title: "Nothing to show yet";
            message: "Type what you are looking for and press Search.";
        }

        // Column labels above the results: Name | Author | Downloads | Last updated | the
        // button column. Hidden while there are no rows to line up under it.
        if !root.modpack_mode && !BrowserState.loading && BrowserState.rows.length > 0:
            results_header := Rectangle {
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                // The same gap the rows below set on their `ListRow`, so a label sits over
                // its own column.
                spacing: Theme.col-gap;

                Rectangle { width: Theme.icon-size; horizontal-stretch: 0; }

                Text {
                    text: "Name";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "Author";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-author;
                    horizontal-stretch: 0;
                }

                Text {
                    text: "Downloads";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-downloads;
                    horizontal-alignment: right;
                    horizontal-stretch: 0;
                }

                Text {
                    text: "Last updated";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-date;
                    horizontal-stretch: 0;
                }

                // The button column's own label, and the one place the target is named:
                // every state line under a button below is about this Minecraft version and
                // loader, so none of them repeats it.
                Text {
                    text: root.target_label() != ""
                        ? "Version for " + root.target_label()
                        : "Version";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    width: Theme.col-action;
                    horizontal-alignment: center;
                    horizontal-stretch: 0;
                    overflow: elide;
                }
            }
        }

        // Arrow keys move the selection, Enter adds the chosen row the same way its button
        // does. Everything else is rejected so the shell's number shortcuts still work.
        //
        // The scope is always mounted, even while there are no results, so the search box
        // above can send the keyboard here by id. It never takes focus by itself: a click on
        // a row or Down out of the search box is what puts the keyboard in the list, so a
        // field the user is typing in is never interrupted.
        keys := FocusScope {
            // Nothing inside while there are no results, so it claims no room and the empty
            // state above is the one that stretches.
            vertical-stretch: root.modpack_mode || BrowserState.loading
                || BrowserState.rows.length == 0 ? 0 : 1;

            // Rows a PageUp/PageDown steps by: however many the list shows at once.
            property <int> page: max(1, floor(self.height / Theme.row-height));
            // The row a key press just chose, so the list (mounted or not) can scroll to it.
            property <int> want-visible: -1;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.selected =
                        Shell.move_selection(root.selected, -1, root.result_count());
                    self.want-visible = root.selected;
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    root.selected =
                        Shell.move_selection(root.selected, 1, root.result_count());
                    self.want-visible = root.selected;
                    return EventResult.accept;
                }
                if (event.text == Key.Home || event.text == Key.End
                    || event.text == Key.PageUp || event.text == Key.PageDown) {
                    root.selected = Shell.jump(
                        root.selected, event.text, self.page, root.result_count());
                    self.want-visible = root.selected;
                    return EventResult.accept;
                }
                if (event.text == Key.Return) {
                    root.activate_selected();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            if !root.modpack_mode && !BrowserState.loading
                && BrowserState.rows.length > 0: list := ListView {
                width: 100%;
                height: 100%;

                // Keeps the selected row inside the viewport after a key moves it. Lives here
                // rather than on the enclosing scope because a conditionally mounted element
                // cannot be reached by id from outside its own `if`. Rows here are variable
                // height (a wrapped title), so this is an approximation from `Theme.row-height`
                // rather than the exact offset.
                property <int> want-visible <=> keys.want-visible;
                changed want-visible => {
                    if (self.want-visible < 0) {
                        return;
                    }
                    if (-self.viewport-y > self.want-visible * Theme.row-height) {
                        self.viewport-y = -self.want-visible * Theme.row-height;
                    }
                    if (-self.viewport-y + self.visible-height
                        < (self.want-visible + 1) * Theme.row-height) {
                        self.viewport-y = self.visible-height
                            - (self.want-visible + 1) * Theme.row-height;
                    }
                }

                for row[i] in BrowserState.rows: row_open := ListRow {
                    title: row.title;
                    column-spacing: Theme.col-gap;
                    // Content-driven: a wrapped multi-line title (see `row_title` below) is
                    // not clipped to a fixed three-line height. `row_layout` is the inner
                    // `VerticalLayout` that carries the title and the description; its
                    // `preferred-height` already reflects however many lines the wrapped
                    // title takes. `row_action`'s own two-line height (button plus the state
                    // line under it) can be the taller one on a short title, so the row takes
                    // whichever is bigger.
                    height: max(row_layout.preferred-height, row_action.preferred-height);
                    selected: i == root.selected;
                    alt: mod(i, 2) == 1;
                    clicked => {
                        // Clicking anywhere on the row but a button opens the details, the
                        // same as clicking the title itself. Clicking a row is also how the
                        // keyboard gets here: the scope never grabs focus on its own, so a
                        // field the user is typing in keeps it.
                        keys.focus();
                        root.selected = i;
                        root.open_project(row.source, row.project_id, row.downloads, row.author);
                    }

                    // The project's icon, or a placeholder tile until it loads (or when the
                    // project has none). `src/screens/browser.rs` fetches and decodes it off
                    // the UI thread and only fills `row.icon` in once it lands.
                    Rectangle {
                        // Top-aligned with the text column's own top padding, rather than
                        // centered, now that a wrapped title can make the row taller than
                        // the icon.
                        y: Theme.gap;
                        width: Theme.icon-size;
                        height: Theme.icon-size;
                        horizontal-stretch: 0;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        if row.icon.width > 0: row_icon := Image {
                            source: row.icon;
                            width: 100%;
                            height: 100%;
                            image-fit: cover;
                        }
                    }

                    // The Name column: icon (above), title, then a muted one-line
                    // description under it. Author, Downloads and Last updated get their
                    // own columns next to this one, so the title line carries nothing else.
                    row_layout := VerticalLayout {
                        padding-top: Theme.gap;
                        padding-bottom: Theme.gap;
                        spacing: Theme.gap / 2;
                        horizontal-stretch: 1;

                        // Not interactive: it carries the `row_title` id and an
                        // accessible-label for a screen reader, but no hover cue, no
                        // underline and no pointer cursor. Clicking anywhere on the row —
                        // including here — opens details through the row's own `clicked`
                        // above, via `ListRow`'s `TouchArea` underneath this Rectangle.
                        row_title := Rectangle {
                            height: title_text.preferred-height;

                            accessible-role: button;
                            accessible-label: row.title;
                            accessible-action-default => {
                                keys.focus();
                                root.selected = i;
                                root.open_project(row.source, row.project_id, row.downloads, row.author);
                            }

                            title_text := Text {
                                text: row.title;
                                color: Theme.text;
                                font-size: Theme.font-size;
                                horizontal-alignment: left;
                                width: 100%;
                                wrap: word-wrap;
                            }
                        }

                        Text {
                            text: row.description;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: row.author;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                        width: Theme.col-author;
                        overflow: elide;
                    }

                    Text {
                        text: row.downloads;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 0;
                        width: Theme.col-downloads;
                    }

                    Text {
                        text: row.updated;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                        width: Theme.col-date;
                    }

                    // The button, and under it the row's newest version for the search
                    // target, whether it is installed, and whether that copy is behind it.
                    // See `row_state_text` above for what each `row.state` reads as.
                    row_action := VerticalLayout {
                        alignment: center;
                        spacing: Theme.gap / 4;
                        horizontal-stretch: 0;
                        width: Theme.col-action;

                        row_install := Button {
                            text: row.kind == "modpack"
                                ? "Install modpack"
                                : (row.state == "installed"
                                    ? "Installed"
                                    : (row.state == "older"
                                        ? "Update"
                                        : (root.has_target
                                            ? "Add to " + BrowserState.target_name
                                            : "Pick an instance")));
                            // A row with nothing at the source for this target has no
                            // version an Add could install, so the button reads that out
                            // rather than the row's own instance name.
                            access_label: row.kind != "modpack" && row.state == "none"
                                ? "No version for this instance"
                                : "";
                            kind: row.state == "installed" ? "secondary" : "primary";
                            enabled: !BrowserState.loading && !BrowserState.busy
                                && (row.kind == "modpack"
                                    || (root.has_target && row.state != "installed"
                                        && row.state != "none"));
                            clicked => {
                                keys.focus();
                                root.selected = i;
                                root.row_primary_action(row.project_id, row.kind, row.title, row.state, row.latest_id);
                            }
                        }

                        row_state_text := Text {
                            text: root.row_state_text(row.state, row.latest_number, row.installed_number);
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Pager and status line.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            prev_button := Button {
                text: "Prev";
                enabled: BrowserState.page > 0 && !BrowserState.loading && !BrowserState.busy;
                clicked => {
                    BrowserState.prev_page();
                }
            }

            next_button := Button {
                text: "Next";
                enabled: BrowserState.has_more && !BrowserState.loading && !BrowserState.busy;
                clicked => {
                    BrowserState.next_page();
                }
            }

            Text {
                text: "Page " + (BrowserState.page + 1);
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            Text {
                text: BrowserState.status;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

// Preview only: `just ui-preview screens/browser.slint` renders this one, because a viewer
// with no `--component` shows the last exported component of the file.
//
// `BrowserState` starts empty, so the screen on its own would preview as a blank list. This
// component fills the global with the sample search the screen used to carry as its
// defaults. Nothing in the app instantiates it.
export component PreviewBrowserScreen inherits BrowserScreen {
    width: 1200px;
    height: 760px;

    init => {
        BrowserState.query = "sodium";
        BrowserState.source_labels = ["modrinth", "curseforge"];
        BrowserState.minecraft = "1.20.1";
        BrowserState.minecraft_options = ["any", "1.20.1", "1.19.4"];
        // Not `minecraft_index`/`loader_index`: `mc_combo` and `loader_combo`'s own
        // `current-index <=> BrowserState.x_index` has to be a two-way alias for the real
        // app (the combo's own arrow-key selection has to win over the state behind it, the
        // same reason `InstanceScreen`'s `gc_combo` is one). Assigning either index from here
        // panics the interpreter ("accessing deleted parent", slint#6426): writing the alias
        // from a component's own `init`, before its children have finished wiring up, tries
        // to sync the other half of that alias before it exists. Both combos start on row 0
        // ("any") in this preview instead; open a live `ui-preview` session and pick a row by
        // hand to see either move.
        BrowserState.loader = "fabric";
        // What `target_label()` actually reads: the target the (imagined) latest-version
        // job resolved against, kept in step with the filters above for the preview.
        BrowserState.latest_minecraft = "1.20.1";
        BrowserState.latest_loader = "fabric";
        BrowserState.target_slug = "fabric-perf";
        BrowserState.target_name = "Fabric Performance";
        BrowserState.has_more = true;
        BrowserState.status = "5 result(s)";
        // One row per `state` a real search can answer with, so the preview shows the
        // whole range: a fresh hit not yet checked, one with nothing for this target, one
        // never installed, one installed and current, and one installed but older.
        BrowserState.rows = [
            {
                source: "modrinth",
                project_id: "AANobbMI",
                slug: "sodium",
                title: "Sodium",
                description: "A modern rendering engine for Minecraft which greatly improves performance.",
                author: "jellysquid3",
                kind: "mod",
                downloads: "45.2M",
                updated: "2026-08-30",
                page_url: "https://modrinth.com/mod/sodium",
                state: "unknown",
            },
            {
                source: "modrinth",
                project_id: "gvQqBUqZ",
                slug: "lithium",
                title: "Lithium: No-Compromises Game Logic and Server Optimisation Mod for Every Modded and Vanilla Server",
                description: "No-compromises game logic and server optimisation mod. Works alongside Sodium and Phosphor with zero known incompatibilities across every supported Minecraft version.",
                author: "jellysquid3",
                kind: "mod",
                downloads: "31.8M",
                updated: "2026-07-14",
                page_url: "https://modrinth.com/mod/lithium",
                state: "none",
            },
            {
                source: "modrinth",
                project_id: "P7dR8mSH",
                slug: "fabric-api",
                title: "Fabric API",
                description: "Essential hooks for modding with Fabric.",
                author: "FabricMC",
                kind: "mod",
                downloads: "120.4M",
                updated: "2026-09-01",
                page_url: "https://modrinth.com/mod/fabric-api",
                latest_number: "0.102.0",
                latest_id: "v-fabric-api-latest",
                state: "not_installed",
            },
            {
                source: "modrinth",
                project_id: "gu5vRgu5",
                slug: "modmenu",
                title: "Mod Menu",
                description: "Adds a mod menu to view a list of mods you have installed.",
                author: "Prospector",
                kind: "mod",
                downloads: "60.1M",
                updated: "2026-06-22",
                page_url: "https://modrinth.com/mod/modmenu",
                latest_number: "11.0.3",
                latest_id: "v-modmenu-latest",
                installed_number: "11.0.3",
                state: "installed",
            },
            {
                source: "modrinth",
                project_id: "hEOCdOgW",
                slug: "cloth-config",
                title: "Cloth Config API",
                description: "A config library for Minecraft mods.",
                author: "shedaniel",
                kind: "mod",
                downloads: "50.7M",
                updated: "2026-05-11",
                page_url: "https://modrinth.com/mod/cloth-config",
                latest_number: "14.0.126",
                latest_id: "v-cloth-config-latest",
                installed_number: "14.0.120",
                state: "older",
            },
        ];
    }
}
