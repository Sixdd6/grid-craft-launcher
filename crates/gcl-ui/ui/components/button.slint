import { Theme } from "../theme.slint";

// Text button. `kind` picks the palette: primary, secondary, danger, or ghost.
export component Button inherits Rectangle {
    in property <string> text: "Button";
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    // What a screen reader says the button is, when it must differ from the printed label —
    // a per-row Install button whose text becomes "Installed", for one, where the label a
    // test or a screen reader wants is the row's own value. Empty falls back to `text`.
    in property <string> access_label: "";
    callback clicked();

    // Resting background: `primary` is filled, every other kind is transparent so the
    // screen behind shows through until hover or press.
    property <color> base: root.kind == "primary" ? Theme.accent : Colors.transparent;
    // Hover tint. `danger` gets its own color at low alpha rather than `surface-hover`, so a
    // destructive row action still reads as dangerous on hover.
    property <color> hover-fill: root.kind == "primary"
        ? Theme.accent-hover
        : (root.kind == "danger" ? Theme.danger.with-alpha(0.12) : Theme.surface-hover);
    property <color> pressed-fill: root.kind == "primary" ? Theme.accent-pressed : root.hover-fill;
    property <color> label-color: root.kind == "primary"
        ? Theme.accent-text
        : (root.kind == "danger" ? Theme.danger : (root.kind == "ghost" ? Theme.text-muted : Theme.text));

    height: Theme.row-height;
    min-width: label.preferred-width + 2 * Theme.pad;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: root.kind == "ghost" ? 0px : 1px;
    border-color: root.kind == "primary"
        ? Theme.accent
        : (root.kind == "danger" ? Theme.danger : (root.kind == "ghost" ? Colors.transparent : Theme.border));
    background: root.base;
    opacity: root.enabled ? 1.0 : 0.5;

    // The testing backend presses a button through its default accessible action, and a
    // screen reader reads `accessible-label`. Both need these four lines; `Rectangle` has no
    // button behaviour of its own.
    accessible-role: button;
    accessible-label: root.access_label == "" ? root.text : root.access_label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        color: root.label-color;
        font-size: Theme.font-size;
        vertical-alignment: center;
        horizontal-alignment: center;
        x: Theme.pad;
        width: root.width - 2 * Theme.pad;
        height: root.height;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    states [
        pressed when touch.pressed: {
            background: root.pressed-fill;
        }
        hover when touch.has-hover: {
            background: root.hover-fill;
        }
    ]

    animate background { duration: 120ms; }
}
