// Data that crosses the Rust/Slint boundary. Rust builds these as VecModels in src/models/.

// One instance in the instances list.
export struct InstanceRow {
    slug: string,
    name: string,
    minecraft: string,
    loader: string,
    loader_version: string,
    last_launched: string,
    installed: bool,
    running: bool,
}

// One installed file inside an instance.
export struct ContentRow {
    project_id: string,
    source: string,
    name: string,
    version: string,
    kind: string,
    enabled: bool,
    update_available: bool,
    file_name: string,
}

// One search hit from a content source.
export struct SearchRow {
    source: string,
    project_id: string,
    slug: string,
    title: string,
    description: string,
    author: string,
    kind: string,
    downloads: string,
    page_url: string,
    // The project's icon URL at the source, empty when it has none. `src/screens/browser.rs`
    // fetches and decodes it off the UI thread and fills `icon` once it lands; `icon.width ==
    // 0` is "not loaded yet" and the row shows a placeholder tile in its place.
    icon_url: string,
    // The decoded icon, built on the UI thread. Empty (`width == 0`) until the row's icon
    // has been fetched, or when the project has none.
    icon: image,
    // Newest version's number for the search target (the picked instance's Minecraft
    // version and loader, or the browser's own filters with no instance picked), empty
    // until `src/screens/browser.rs`'s `fetch_latest` job answers for this row.
    latest_number: string,
    // Id of that version. What Update installs through `BrowserState.add`.
    latest_id: string,
    // Number of the version already installed for this project, empty when none is.
    installed_number: string,
    // "unknown" until the job answers, then "none" (no version fits the target),
    // "not_installed", "installed", or "older" (the installed copy is behind `latest_number`).
    state: string,
}

// One saved account.
export struct AccountRow {
    id: string,
    name: string,
    kind: string,
    expires: string,
    active: bool,
}

// One tracked task. `status` is running, done, or failed.
export struct TaskRow {
    id: int,
    label: string,
    fraction: float,
    status: string,
    detail: string,
}

// One transient message stacked over the shell. `kind` is warning, error, or info.
export struct ToastRow {
    text: string,
    kind: string,
}

// One line in the app log.
export struct LogLine {
    level: string,
    text: string,
}

// One editable setting.
export struct SettingRow {
    key: string,
    value: string,
}

// One line of the typed settings editor: a group header, or one setting with the control it
// is edited with.
//
// `control` is "group" for a header, else "slider", "toggle", "choice", or "text". A header
// carries the group name in `label`, how many settings it holds in `choice_index`, and
// whether it is open in `checked`. Everything else is a setting row: `value` is the string
// `options.txt` would hold, and the typed fields are the same value read for its control.
//
// A slider row is carried in the numbers a user reads, not the numbers `options.txt` holds:
// `number`, `minimum`, `maximum` and `step` are already scaled, `unit` is what follows the
// number, and `display_decimals` says how many digits it is written with. `decimals` stays
// the stored precision, which only `src/models/settings.rs` uses. For every setting but
// `fov` the two are the same number.
export struct SettingRowModel {
    key: string,
    label: string,
    group: string,
    control: string,
    value: string,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    decimals: int,
    display_decimals: int,
    unit: string,
    checked: bool,
    choices: [string],
    choice_index: int,
    source: string,
    inherited: bool,
    resettable: bool,
}

// One garbage collector preset offered on the JVM tab's combo box.
//
// `token` is what `InstanceState.gc_pick` sends back to Rust (`GcPreset`'s serde token, e.g.
// `"g1"`), matched against `GcPreset::from_str` in `src/screens/instance.rs`. `label` is the
// combo's menu text and `description` is the one-line trade-off shown under it, both built
// from `GcPreset::label()`/`GcPreset::description()` in gcl-core, never hand-written here.
export struct GcPresetRow {
    token: string,
    label: string,
    description: string,
}

// One loader build offered for an instance.
export struct LoaderVersionRow {
    version: string,
    stable: bool,
    recommended: bool,
}

// One Minecraft version from the Mojang manifest.
export struct VersionRow {
    id: string,
    kind: string,
    release_time: string,
}

// One download the user still has to fetch by hand.
export struct PendingRow {
    project_id: string,
    file_name: string,
    page_url: string,
    kind: string,
}

// One piece of a project's rendered description, or a version's changelog, from
// `richtext::Block` in gcl-core.
//
// `kind` is one of `heading1`..`heading6`, `paragraph`, `bullet`, `code`, `table`, `rule`,
// `quote`, or `image`. A link inside `text` already reads `text (url)`, per `richtext`'s own
// conversion, so `BlockList` renders `text` as plain wrapped prose with no further markup to
// interpret, except where a field below says otherwise.
//
// Which fields a kind fills in, the rest staying at their type default (`0`, `""`, `[]`, an
// empty `image`):
// - `bullet`: `text` is the item, `depth` is its nesting (0 for a top-level item).
// - `table`: `columns` and `cells`, row-major, header included as row 0 —
//   `cells[row * columns + col]`. `text` is empty; there is no single string for a table.
// - `rule`: no field carries anything; the kind alone is the whole block.
// - `quote`: `text` is the quoted line.
// - `image`: `text` is the alt text, shown under the image or in its place on failure. `url`
//   is the image's source, `image` is its decoded pixels once fetched, and `image_state` is
//   `""` until `screens/project.rs` starts the fetch, then `loading`, `ready`, or `failed`.
//   `screens/project.rs` writes `image`/`image_state` onto this block's own row in place once
//   the fetch lands, so this struct is the only place the state lives on screen.
export struct Block {
    kind: string,
    text: string,
    depth: int,
    url: string,
    columns: int,
    cells: [string],
    image: image,
    image_state: string,
}

// One version row on the project details screen's Versions tab.
//
// `game_versions` and `loaders` are pre-joined for display, the same way other rows in this
// file avoid passing an array where a joined string prints fine. `installed` marks the row
// whose `id` matches the target instance's installed `version_id` for this project.
export struct ContentVersionRow {
    id: string,
    number: string,
    kind: string,
    release_time: string,
    game_versions: string,
    loaders: string,
    installed: bool,
    // Whether the target instance can run this version: it lists the instance's Minecraft
    // version and, for a mod, a compatible loader. Always true when there is no target.
    compatible: bool,
    // What the Install button's accessible label says: "Install <number>" or
    // "Installed <number>" when it can run, "Not for <mc> <loader>" when it cannot.
    access_label: string,
}

// Which screen the shell shows.
export enum Screen {
    instances,
    instance,
    browser,
    accounts,
    settings,
    project,
}
