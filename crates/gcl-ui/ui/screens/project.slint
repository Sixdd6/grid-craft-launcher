import { CheckBox, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Block, ContentVersionRow, Screen } from "../types.slint";
import { BlockList } from "../components/block-list.slint";
import { Button } from "../components/button.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ListRow } from "../components/list-row.slint";
import { NotesDialog } from "../components/notes-dialog.slint";
import { TabBar } from "../components/tab-bar.slint";

// Everything the project details screen reads and reports.
//
// The screen lives inside an `if` in `app.slint`, so Rust cannot reach its properties. This
// global is the seam, the same way `InstanceState` is for the detail view:
// `src/screens/project.rs` binds it, and the screen reads it directly. It lives in its own
// file because the screen imports it and `app.slint` imports the screen, which a global
// declared in `app.slint` could not survive.
//
// `return_to` is the smallest thing a real back stack would need: whoever opens this screen
// (a browser row's title, an instance's content-row source button) says which screen `back()`
// returns to, and `App.current_slug` is left alone so the instance detail screen still shows
// the right instance when that is where the user came from.
//
// Every property here starts empty: nobody has opened a project until `open` is called, and
// `src/screens/project.rs` fills every one of them, the empty case included. The sample
// values the preview needs live in `PreviewProjectScreen`, at the end of this file.
export global ProjectState {
    // Source this project came from: "modrinth" or "curseforge".
    in-out property <string> source: "";
    // Project id at that source.
    in-out property <string> project_id: "";
    // Display title.
    in-out property <string> title: "";
    // Author or team name. Empty: `gcl-core`'s `Project` carries no author field today.
    in-out property <string> author: "";
    // Content kind: mod, resourcepack, shader, datapack, world.
    in-out property <string> kind: "";
    // Total download count, already formatted. Empty: `Launcher::project_details` answers
    // with no count; a future caller that already has one (a search row, for one) can fill
    // this in without changing the shape here.
    in-out property <string> downloads: "";
    // Browser link to the project's page at the source.
    in-out property <string> page_url: "";
    // Slug of the instance a version installs into, empty when none was picked.
    in-out property <string> target_slug: "";

    // Which tab is shown: 0 description, 1 versions.
    in-out property <int> tab: 0;
    // The description, one block per heading, paragraph, bullet, or code run.
    in-out property <[Block]> blocks: [];
    // The project's versions, filtered by the target instance unless `show_all_versions` is
    // set. One row is marked `installed` when its id matches what the target instance has.
    in-out property <[ContentVersionRow]> versions: [];
    // Whether the version list ignores the target instance's Minecraft version and loader.
    in-out property <bool> show_all_versions: false;

    // True while the description, the versions, or an install is loading.
    in-out property <bool> loading: false;
    // One line about the last thing that happened here.
    in-out property <string> status: "";
    // Where `back()` returns to: the screen that opened this one.
    in-out property <Screen> return_to: Screen.browser;

    // Whether the Notes modal is open.
    in-out property <bool> notes_open: false;
    // The modal's title, already formatted as "<number> notes".
    in-out property <string> notes_title: "";
    // The changelog for the version the modal was opened for, same block shape as `blocks`.
    in-out property <[Block]> notes_blocks: [];
    // True while that changelog is being fetched.
    in-out property <bool> notes_loading: false;

    // Opens a project's details. Carries the source, the project id, the instance a version
    // installs into (empty when none was picked), the screen `back()` returns to, and the
    // download count and author to show right away, already formatted: a search row already
    // carries both, and `Launcher::project_details` answers with neither, so an open from
    // the installed list passes empty strings for them.
    callback open(string /* source */, string /* project_id */, string /* target_slug */, Screen /* return_to */, string /* downloads */, string /* author */);
    // Returns to `return_to`.
    callback back();
    // The "Show all versions" checkbox changed.
    callback toggle_show_all();
    // A version row's Install button was pressed. Carries the version id.
    callback install(string /* version_id */);
    // A version row's Notes button was pressed. Carries the version id and its display number.
    callback open_notes(string /* version_id */, string /* number */);
    // The Notes modal was closed.
    callback close_notes();
}

// The project details screen: a header, a Description/Versions `TabBar`, and the tab body.
//
// Pure layout. Every value comes from `ProjectState` and every action is reported through it,
// so `src/screens/project.rs` is the only place that knows what any of this means.
export component ProjectScreen inherits Rectangle {
    background: Theme.bg;

    // Whether a version has somewhere to install into.
    property <bool> has_target: ProjectState.target_slug != "";

    // Escape returns to where these details were opened from. This screen is mounted only
    // while it is shown, the same as a `Dialog`, so grabbing the keyboard once on mount is
    // safe here even though a list scope never does: `app.slint`'s own `nav` scope does not
    // reclaim focus when navigating to this screen (see its `changed shown_screen`), so
    // nothing takes it back from `keys`.
    init => {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                ProjectState.back();
                return EventResult.accept;
            }
            // Everything else bubbles to `nav`, which is what keeps the rail's number
            // shortcuts working while these details are up.
            return EventResult.reject;
        }

        VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // Header: back button, title, and the details a browser row does not carry.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            back_button := Button {
                text: "Back";
                clicked => {
                    ProjectState.back();
                }
            }

            Text {
                text: ProjectState.title;
                color: Theme.text;
                font-size: Theme.font-size-h1;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            if ProjectState.author != "": Text {
                text: "by " + ProjectState.author;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            Rectangle {
                horizontal-stretch: 0;
                width: kind_badge.preferred-width + Theme.gap;
                background: Theme.surface-raised;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;

                kind_badge := Text {
                    text: ProjectState.kind;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if ProjectState.downloads != "": Text {
                text: ProjectState.downloads + " downloads";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // The project's page at the source, read-only and selectable: there is no clipboard
        // call this crate can reach from a button, so selection is the whole copy story.
        //
        // A row taller than `Theme.row-height`: `TextEdit`'s own padding otherwise clips
        // the one line of text it holds.
        page_url_text := TextEdit {
            height: Theme.row-height + Theme.gap;
            text: ProjectState.page_url;
            read-only: true;
            wrap: no-wrap;
        }

        tabs := TabBar {
            tabs: ["Description", "Versions"];
            current <=> ProjectState.tab;
        }

        // Description tab: a scrolling column of blocks, styled by kind.
        if ProjectState.tab == 0: ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.pad;
                spacing: Theme.gap;
                alignment: start;

                if ProjectState.blocks.length == 0 && !ProjectState.loading: EmptyState {
                    title: "No description";
                }

                BlockList {
                    blocks: ProjectState.blocks;
                }
            }
        }

        // Versions tab: one row per version, an Install button per row, and the filter
        // checkbox. A row whose version is already installed shows "Installed" instead.
        if ProjectState.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.gap;

            HorizontalLayout {
                height: Theme.row-height;
                spacing: Theme.gap;

                show_all_versions_check := CheckBox {
                    text: "Show all versions";
                    checked <=> ProjectState.show_all_versions;
                    toggled => {
                        ProjectState.toggle_show_all();
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                if !root.has_target: Text {
                    text: "Pick a target instance in the browser first";
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                }
            }

            if ProjectState.versions.length == 0 && !ProjectState.loading: EmptyState {
                vertical-stretch: 1;
                title: "No versions to show";
            }

            if ProjectState.versions.length > 0: ListView {
                vertical-stretch: 1;
                width: 100%;

                for row[i] in ProjectState.versions: version_row := Rectangle {
                    height: 2 * Theme.font-size + 2 * Theme.gap + Theme.pad;
                    border-radius: Theme.radius;

                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: Theme.gap;

                    VerticalLayout {
                        padding-top: Theme.gap;
                        padding-bottom: Theme.gap;
                        spacing: Theme.gap / 2;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: Theme.gap;

                            Text {
                                text: row.number;
                                color: Theme.text;
                                font-size: Theme.font-size;
                                horizontal-stretch: 0;
                                overflow: elide;
                            }

                            Rectangle {
                                horizontal-stretch: 0;
                                width: version_kind_badge.preferred-width + Theme.gap;
                                background: Theme.surface-raised;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.border;

                                version_kind_badge := Text {
                                    text: row.kind;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-size-small;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: row.release_time;
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }

                        // Game versions and loaders on one line, shortening the row.
                        Text {
                            text: row.loaders == ""
                                ? row.game_versions
                                : row.game_versions + " · " + row.loaders;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        spacing: Theme.gap;

                        version_notes_button := Button {
                            text: "Notes";
                            access_label: "Notes " + row.number;
                            kind: "secondary";
                            clicked => {
                                ProjectState.open_notes(row.id, row.number);
                            }
                        }

                        version_install_button := Button {
                            text: row.installed ? "Installed" : "Install";
                            access_label: row.access_label;
                            kind: "primary";
                            enabled: !row.installed && root.has_target && !ProjectState.loading
                                && row.compatible;
                            clicked => {
                                ProjectState.install(row.id);
                            }
                        }
                    }
                    }
                }
            }
        }

        Text {
            text: ProjectState.loading ? "Loading…" : ProjectState.status;
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            height: Theme.row-height;
            vertical-alignment: center;
            overflow: elide;
        }
        }
    }
}

// Preview only: `just ui-preview screens/project.slint` renders this one, because a viewer
// with no `--component` shows the last exported component of the file.
//
// `ProjectState` starts empty, so the screen on its own would preview as a blank page. This
// component fills the global with the sample project the screen used to carry as its
// defaults. Nothing in the app instantiates it.
export component PreviewProjectScreen inherits ProjectScreen {
    width: 1200px;
    height: 760px;

    init => {
        ProjectState.source = "modrinth";
        ProjectState.project_id = "AANobbMI";
        ProjectState.title = "Sodium";
        ProjectState.author = "jellysquid3";
        ProjectState.kind = "mod";
        ProjectState.downloads = "45.2M";
        ProjectState.page_url = "https://modrinth.com/mod/sodium";
        ProjectState.target_slug = "fabric-perf";
        ProjectState.status = "Ready";
        ProjectState.blocks = [
            { kind: "heading1", text: "Sodium" },
            {
                kind: "paragraph",
                text: "A modern rendering engine for Minecraft which greatly improves performance (https://modrinth.com/mod/sodium).",
            },
            { kind: "heading2", text: "Features" },
            { kind: "bullet", text: "Significantly improved frame rates", depth: 0 },
            { kind: "bullet", text: "Much better frame pacing", depth: 0 },
            { kind: "bullet", text: "Configurable advanced culling", depth: 1 },
            { kind: "bullet", text: "Per-chunk culling passes", depth: 2 },
            { kind: "rule" },
            {
                kind: "quote",
                text: "Sodium requires a graphics driver with OpenGL 4.6 support.",
            },
            {
                kind: "table",
                columns: 3,
                cells: [
                    "Minecraft", "Loader", "Status",
                    "1.21.1", "Fabric", "Supported",
                    "1.21.1", "Quilt", "Supported",
                    "1.20.1", "Fabric", "Legacy",
                ],
            },
            {
                kind: "image",
                text: "Sodium's F3 debug overlay",
                image_state: "loading",
            },
            { kind: "code", text: "sodium.enable_advanced_culling=true" },
        ];
        ProjectState.versions = [
            {
                id: "abc123",
                number: "0.6.13",
                kind: "release",
                release_time: "2026-08-01 10:00",
                game_versions: "1.21.1, 1.21",
                loaders: "fabric, quilt",
                installed: true,
                compatible: true,
                access_label: "Installed 0.6.13",
            },
            {
                id: "def456",
                number: "0.6.12",
                kind: "release",
                release_time: "2026-06-01 10:00",
                game_versions: "1.21.1, 1.21",
                loaders: "fabric, quilt",
                installed: false,
                compatible: true,
                access_label: "Install 0.6.12",
            },
            {
                id: "ghi789",
                number: "0.5.11",
                kind: "release",
                release_time: "2026-01-01 10:00",
                game_versions: "1.20.1",
                loaders: "fabric",
                installed: false,
                compatible: false,
                access_label: "Not for 1.21.1 fabric",
            },
        ];
        // `NotesDialog` is mounted in `app.slint`, not here, but the preview shows it anyway
        // so a change to it can be checked without running the whole app: see the `notes_open`
        // below and the `NotesDialog` instance this component adds, wired the same way
        // `app.slint`'s own copy is.
        ProjectState.notes_title = "0.6.13";
        ProjectState.notes_blocks = [
            { kind: "heading3", text: "0.6.13" },
            { kind: "bullet", text: "Fixed a crash on some AMD drivers", depth: 0 },
            { kind: "bullet", text: "Improved chunk build throughput", depth: 0 },
        ];
        ProjectState.notes_open = true;
    }

    if ProjectState.notes_open: NotesDialog {
        width: root.width;
        height: root.height;
        open: ProjectState.notes_open;
        title: "" + ProjectState.notes_title + " notes";
        blocks: ProjectState.notes_blocks;
        loading: ProjectState.notes_loading;
        close => {
            ProjectState.close_notes();
        }
    }
}
