import { Theme } from "../theme.slint";

// One dense row in a list. Hover and selection are drawn here, content comes from children.
export component ListRow inherits Rectangle {
    in property <bool> selected: false;
    // Odd-row tint for a dense list that alternates backgrounds. The caller decides which
    // rows are odd (`mod(i, 2) == 1`); selection and hover still win over it.
    in property <bool> alt: false;
    // What a screen reader says the row is. Set it to the row's primary text.
    in property <string> title;
    // Gap between the row's own columns. A list whose rows line up under a column header
    // sets the same value on both, so the two never drift apart.
    in property <length> column-spacing: Theme.gap;
    callback clicked();

    height: Theme.row-height;
    border-radius: Theme.radius;
    background: root.selected
        ? Theme.accent.with-alpha(0.18)
        : (row_touch.has-hover
            ? Theme.surface-hover
            : (root.alt ? Theme.surface-alt : Colors.transparent));

    accessible-role: button;
    accessible-label: root.title;
    // The stripe, spelled out for a flow test: only `alt` decides it, and there is no other
    // way to read a background color back out of the element tree.
    accessible-description: root.alt ? "alt" : "";
    accessible-action-default => {
        root.clicked();
    }

    row_touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        spacing: root.column-spacing;
        @children
    }

    animate background { duration: 100ms; }
}
