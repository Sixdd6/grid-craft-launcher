import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AccountsState } from "../state.slint";
import { Button } from "../components/button.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ListRow } from "../components/list-row.slint";

// The account list: one row per saved account, with the two ways to add one on top.
//
// Pure layout. Every value comes from the [`AccountsState`] global and every action is
// reported through it, so `src/screens/accounts.rs` is the only place that knows what any of
// this means.
export component AccountsScreen inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // Header: title and the two ways to add an account.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            Text {
                text: "Accounts";
                color: Theme.text;
                font-size: Theme.font-size-h1;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            // The hint says why Microsoft sign-in is off, in place of the button's tooltip.
            if !AccountsState.msa_available: Text {
                text: AccountsState.msa_hint;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if AccountsState.msa_available: Rectangle {
                horizontal-stretch: 1;
            }

            Button {
                text: "Add offline";
                enabled: !AccountsState.busy;
                clicked => {
                    AccountsState.add_offline();
                }
            }

            Button {
                text: "Sign in with Microsoft";
                kind: "primary";
                enabled: AccountsState.msa_available && !AccountsState.busy;
                clicked => {
                    AccountsState.sign_in();
                }
            }
        }

        if AccountsState.rows.length == 0: EmptyState {
            vertical-stretch: 1;
            title: "No accounts yet";
            message: "Add an offline account to play single player, or sign in with "
                + "Microsoft to play with your own copy of the game.";
        }

        if AccountsState.rows.length > 0: ListView {
            vertical-stretch: 1;

            for row in AccountsState.rows: ListRow {
                selected: row.active;

                Text {
                    text: row.name;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                    overflow: elide;
                }

                Rectangle {
                    horizontal-stretch: 0;
                    width: badge.preferred-width + Theme.gap;
                    background: Theme.surface-raised;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;

                    badge := Text {
                        text: row.kind;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: row.active ? "active" : "";
                    color: Theme.accent;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Text {
                    text: row.expires == "" ? "" : "signed in until " + row.expires;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Button {
                    text: "Select";
                    enabled: !row.active && !AccountsState.busy;
                    clicked => {
                        AccountsState.select(row.id);
                    }
                }

                // Shown on every row so the buttons line up, but only a Microsoft account
                // has a saved sign-in to renew.
                Button {
                    text: "Refresh";
                    enabled: row.kind == "msa" && !AccountsState.busy;
                    clicked => {
                        AccountsState.refresh(row.id);
                    }
                }

                Button {
                    text: "Remove";
                    kind: "danger";
                    enabled: !AccountsState.busy;
                    clicked => {
                        AccountsState.remove(row.id);
                    }
                }
            }
        }

        Text {
            text: AccountsState.status;
            color: Theme.text-muted;
            font-size: Theme.font-size-small;
            height: Theme.row-height;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
