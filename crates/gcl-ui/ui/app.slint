import { Theme } from "theme.slint";
import {
    AccountRow, ContentRow, InstanceRow, LoaderVersionRow, LogLine, PendingRow,
    Screen, SearchRow, SettingRow, TaskRow, VersionRow
} from "types.slint";
import { AccountsState, InstanceState, SettingsState } from "state.slint";
import { Rail } from "components/rail.slint";
import { ChoiceDialog } from "components/choice-dialog.slint";
import { ConfirmDialog } from "components/confirm-dialog.slint";
import { DeviceCodeDialog } from "components/device-code-dialog.slint";
import { CreateInstanceDialog } from "components/create-instance-dialog.slint";
import { Dialog } from "components/dialog.slint";
import { PromptDialog } from "components/prompt-dialog.slint";
import { ProgressBar } from "components/progress-bar.slint";
import { InstancesScreen } from "screens/instances.slint";
import { InstanceScreen } from "screens/instance.slint";
import { BrowserScreen, BrowserState } from "screens/browser.slint";
import { AccountsScreen } from "screens/accounts.slint";
import { SettingsScreen } from "screens/settings.slint";

// Re-exported so the generated Rust module has every struct the screens will need.
export {
    AccountRow, AccountsState, BrowserState, ContentRow, InstanceRow, InstanceState,
    LoaderVersionRow, LogLine, PendingRow, Screen, SearchRow, SettingRow, SettingsState, TaskRow,
    Theme, VersionRow
}

// Shell state and the callbacks Rust wires up. Screens read from here, never from each other.
export global App {
    in-out property <Screen> screen: Screen.instances;
    in-out property <string> current_slug;
    in-out property <string> status_text: "Ready";
    in-out property <bool> busy: false;
    in-out property <[TaskRow]> tasks;
    in-out property <[LogLine]> app_log;
    in-out property <string> error_title;
    in-out property <string> error_text;
    in-out property <bool> error_open: false;

    callback navigate(Screen);
    callback open_instance(string);
    callback dismiss_error();
}

// Everything the instances screen and its two modals read and report.
//
// The screens themselves stay pure layout, and they live inside an `if`, so Rust cannot reach
// their properties. This global is the seam: `src/screens/instances.rs` binds it, and the
// window below copies it into the screen.
export global InstancesState {
    // Instances to show, already filtered by `filter`.
    in-out property <[InstanceRow]> rows;
    // Every instance, before `filter` is applied. Rust owns it and re-derives `rows` from it.
    in-out property <[InstanceRow]> all_rows;
    // What the user typed into the list's search box.
    in-out property <string> filter;
    // True while the list is being read from disk.
    in-out property <bool> loading: false;

    // Whether the new-instance form is up.
    in-out property <bool> create_open: false;
    // Name typed into that form.
    in-out property <string> create_name;
    // True from the moment the form is submitted until the instance is on disk.
    in-out property <bool> create_busy: false;
    // Minecraft versions the form offers, already filtered by `show_snapshots`.
    in-out property <[VersionRow]> versions;
    // Every published version. Rust owns it and re-derives `versions` from it.
    in-out property <[VersionRow]> all_versions;
    // One label per entry of `versions`, in the same order.
    in-out property <[string]> version_labels;
    // Index into `versions`, or -1 when nothing is chosen.
    in-out property <int> version_index: -1;
    // Whether the form offers snapshots as well as releases.
    in-out property <bool> show_snapshots: false;
    // 0 none, 1 fabric, 2 quilt, 3 forge, 4 neoforge.
    in-out property <int> loader_index: 0;
    // Builds of the chosen loader for the chosen Minecraft version.
    in-out property <[LoaderVersionRow]> loader_versions;
    // One label per entry of `loader_versions`, in the same order.
    in-out property <[string]> loader_version_labels;
    // Index into `loader_versions`, or -1 when nothing is chosen.
    in-out property <int> loader_version_index: -1;
    // True while the loader build list is being fetched.
    in-out property <bool> loading_loader_versions: false;

    // Whether the yes/no modal is up.
    in-out property <bool> confirm_open: false;
    // Headline of that modal.
    in-out property <string> confirm_title;
    // Body text of that modal.
    in-out property <string> confirm_text;
    // Label of its affirming button.
    in-out property <string> confirm_label: "Confirm";
    // True when confirming destroys something.
    in-out property <bool> confirm_danger: false;
    // Slug the yes/no modal is asking about.
    in-out property <string> confirm_slug;

    // Re-read the instance list from disk.
    callback refresh();
    // The search box changed. Carries the new filter.
    callback filter_changed(string);
    // The Create button was pressed: load versions, then open the form.
    callback create();
    // The form was submitted: name, Minecraft id, loader slug, loader build.
    callback create_confirm(string, string, string, string);
    // The form was dismissed.
    callback create_cancel();
    // Fetch the builds of a loader for a Minecraft version.
    callback load_loader_versions(string /* mc */, string /* loader */);
    // The snapshots checkbox changed. Carries its new state.
    callback snapshots_changed(bool);
    // Launch one instance by slug.
    callback launch(string);
    // A row's Delete button was pressed. Opens the yes/no modal.
    callback delete(string);
    // The yes/no modal was confirmed.
    callback confirm_yes();
    // The yes/no modal was dismissed.
    callback confirm_no();
}

export component AppWindow inherits Window {
    title: "GRID Craft Launcher";
    background: Theme.bg;
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1200px;
    preferred-height: 760px;

    // The instance the detail screen is showing, empty while another screen is up. Rust
    // cannot watch a property, so the reload is triggered here: navigating to the screen and
    // picking another instance both change this.
    property <string> shown_slug: App.screen == Screen.instance ? App.current_slug : "";

    changed shown_slug => {
        if (self.shown_slug != "") {
            InstanceState.load(self.shown_slug);
        }
    }

    // Whether the browser is up. The browser loads its sources, its instance list, and its
    // prefilled filters when it is shown, for the same reason the detail screen does: Rust
    // cannot watch a property, so navigating to the screen is what triggers the load.
    property <bool> browser_open: App.screen == Screen.browser;

    changed browser_open => {
        if (self.browser_open) {
            BrowserState.open();
        }
    }

    // Whether the accounts screen is up. It reloads the account store when it is shown, for
    // the same reason the browser reloads its sources: Rust cannot watch a property.
    property <bool> accounts_open: App.screen == Screen.accounts;

    changed accounts_open => {
        if (self.accounts_open) {
            AccountsState.open();
        }
    }

    // Whether the settings screen is up. It re-reads the config when it is shown.
    property <bool> settings_open: App.screen == Screen.settings;

    changed settings_open => {
        if (self.settings_open) {
            SettingsState.open();
        }
    }

    // Newest app-log line, which is what the device-code dialog shows while a sign-in runs.
    property <string> newest_log: App.app_log.length > 0
        ? App.app_log[App.app_log.length - 1].text
        : "";

    // The newest log line, shown as a toast while it is a warning.
    property <string> toast_text: App.app_log.length > 0
        && App.app_log[App.app_log.length - 1].level == "warning"
        ? App.app_log[App.app_log.length - 1].text
        : "";

    HorizontalLayout {
        Rail {
            current: App.screen;
            navigate(target) => {
                App.navigate(target);
            }
        }

        VerticalLayout {
            // Screen area. One screen is instantiated at a time.
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg;

                if App.screen == Screen.instances: InstancesScreen {
                    rows: InstancesState.rows;
                    filter <=> InstancesState.filter;
                    loading: InstancesState.loading;
                    open(slug) => {
                        App.open_instance(slug);
                    }
                    create => {
                        InstancesState.create();
                    }
                    delete(slug) => {
                        InstancesState.delete(slug);
                    }
                    launch(slug) => {
                        InstancesState.launch(slug);
                    }
                    refresh => {
                        InstancesState.refresh();
                    }
                    changed filter => {
                        InstancesState.filter_changed(self.filter);
                    }
                }
                if App.screen == Screen.instance: InstanceScreen { }
                if App.screen == Screen.browser: BrowserScreen { }
                if App.screen == Screen.accounts: AccountsScreen { }
                if App.screen == Screen.settings: SettingsScreen { }
            }

            // Bottom strip: task count, the first task, and the status line.
            // The full task panel lands in task 7.
            Rectangle {
                height: Theme.row-height + Theme.gap;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: Theme.pad;
                    padding-right: Theme.pad;
                    spacing: Theme.pad;

                    Text {
                        text: App.tasks.length == 0
                            ? "No tasks"
                            : App.tasks.length + " task(s)";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }

                    Text {
                        text: App.tasks.length > 0 ? App.tasks[0].label : App.status_text;
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        ProgressBar {
                            width: 160px;
                            visible: App.tasks.length > 0;
                            fraction: App.tasks.length > 0 ? App.tasks[0].fraction : 0;
                        }
                    }
                }
            }
        }
    }

    // Toast host. Shows the newest warning until a later line replaces it.
    toast := Rectangle {
        visible: root.toast_text != "";
        width: min(root.width - 4 * Theme.pad, 520px);
        height: label.preferred-height + 2 * Theme.gap;
        x: root.width - self.width - 2 * Theme.pad;
        y: root.height - self.height - Theme.row-height - 3 * Theme.gap;
        background: Theme.surface-raised;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.warning;

        label := Text {
            x: Theme.pad;
            width: parent.width - 2 * Theme.pad;
            y: Theme.gap;
            text: root.toast_text;
            color: Theme.text;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
    }

    // New-instance form. Always mounted; it paints nothing while `open` is false.
    CreateInstanceDialog {
        width: root.width;
        height: root.height;
        open: InstancesState.create_open;
        name <=> InstancesState.create_name;
        busy: InstancesState.create_busy;
        versions: InstancesState.versions;
        version_labels: InstancesState.version_labels;
        version_index <=> InstancesState.version_index;
        show_snapshots <=> InstancesState.show_snapshots;
        loader_index <=> InstancesState.loader_index;
        loader_versions: InstancesState.loader_versions;
        loader_version_labels: InstancesState.loader_version_labels;
        loader_version_index <=> InstancesState.loader_version_index;
        loading_loader_versions: InstancesState.loading_loader_versions;
        load_loader_versions(mc, loader) => {
            InstancesState.load_loader_versions(mc, loader);
        }
        confirm(name, mc, loader, loader_version) => {
            InstancesState.create_confirm(name, mc, loader, loader_version);
        }
        cancel => {
            InstancesState.create_cancel();
        }
        changed show_snapshots => {
            InstancesState.snapshots_changed(self.show_snapshots);
        }
    }

    // Yes/no modal, currently used by the delete action.
    ConfirmDialog {
        width: root.width;
        height: root.height;
        open: InstancesState.confirm_open;
        title: InstancesState.confirm_title;
        text: InstancesState.confirm_text;
        confirm_label: InstancesState.confirm_label;
        danger: InstancesState.confirm_danger;
        confirm => {
            InstancesState.confirm_yes();
        }
        cancel => {
            InstancesState.confirm_no();
        }
    }

    // Offline-name prompt, used when a launch found no account.
    PromptDialog {
        width: root.width;
        height: root.height;
        open: InstanceState.prompt_open;
        title: InstanceState.prompt_title;
        label: InstanceState.prompt_label;
        value <=> InstanceState.prompt_value;
        accept_label: "Launch";
        accept(name) => {
            InstanceState.prompt_ok(name);
        }
        cancel => {
            InstanceState.prompt_cancel();
        }
    }

    // New-instance name prompt, used when a modpack is installed from the browser.
    PromptDialog {
        width: root.width;
        height: root.height;
        open: BrowserState.name_open;
        title: "Install modpack";
        label: "Instance name";
        placeholder: "My modpack";
        value <=> BrowserState.name_value;
        accept_label: "Install";
        accept(name) => {
            BrowserState.name_ok(name);
        }
        cancel => {
            BrowserState.name_cancel();
        }
    }

    // World chooser, used when a data pack is added from the browser.
    ChoiceDialog {
        width: root.width;
        height: root.height;
        open: BrowserState.choice_open;
        title: "Choose a world";
        label: "The data pack is installed into this world's datapacks folder.";
        options: BrowserState.choice_options;
        index <=> BrowserState.choice_index;
        accept_label: "Add";
        accept(world) => {
            BrowserState.choice_ok(world);
        }
        cancel => {
            BrowserState.choice_cancel();
        }
    }

    // Microsoft sign-in. The status line is the newest log line, which is where the login's
    // own progress lands; it is only read while the sign-in is running.
    DeviceCodeDialog {
        width: root.width;
        height: root.height;
        open: AccountsState.device_open;
        code: AccountsState.device_code;
        uri: AccountsState.device_uri;
        status: root.newest_log;
        busy: AccountsState.busy;
        cancel => {
            AccountsState.cancel_sign_in();
        }
    }

    // Offline-account name prompt, opened by the accounts screen's Add offline button.
    PromptDialog {
        width: root.width;
        height: root.height;
        open: AccountsState.prompt_open;
        title: "Add offline account";
        label: "Player name";
        value <=> AccountsState.prompt_value;
        accept_label: "Add";
        accept(name) => {
            AccountsState.prompt_ok(name);
        }
        cancel => {
            AccountsState.prompt_cancel();
        }
    }

    // Remove-account confirmation.
    ConfirmDialog {
        width: root.width;
        height: root.height;
        open: AccountsState.confirm_open;
        title: "Remove account?";
        text: AccountsState.confirm_text;
        confirm_label: "Remove";
        danger: true;
        confirm => {
            AccountsState.confirm_yes();
        }
        cancel => {
            AccountsState.confirm_no();
        }
    }

    // Error dialog. Rust sets the three error properties; dismiss_error clears them.
    Dialog {
        width: root.width;
        height: root.height;
        open: App.error_open;
        title: App.error_title;
        close-text: "Dismiss";
        close => {
            App.dismiss_error();
        }

        Text {
            text: App.error_text;
            color: Theme.text-muted;
            font-size: Theme.font-size;
            wrap: word-wrap;
        }
    }
}
