import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { InstanceRow } from "../types.slint";
import { Button } from "../components/button.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ListRow } from "../components/list-row.slint";
import { SearchBox } from "../components/search-box.slint";
import { Shell } from "../state.slint";

// The instance list: header, one dense row per instance, and an empty state.
//
// Pure layout. `rows` is already filtered by Rust; `filter` only carries what the user typed
// back out, so the owner can re-filter and set `rows` again.
export component InstancesScreen inherits Rectangle {
    // Instances to show, in display order.
    in property <[InstanceRow]> rows: [
        {
            slug: "vanilla",
            name: "Vanilla 1.21",
            minecraft: "1.21",
            loader: "none",
            loader_version: "",
            last_launched: "2026-09-05 21:14",
            installed: true,
            running: false,
        },
        {
            slug: "fabric-perf",
            name: "Fabric Performance",
            minecraft: "1.20.1",
            loader: "fabric",
            loader_version: "0.16.9",
            last_launched: "2026-09-06 08:02",
            installed: true,
            running: true,
        },
        {
            slug: "create-above",
            name: "Create: Above and Beyond",
            minecraft: "1.18.2",
            loader: "forge",
            loader_version: "40.2.21",
            last_launched: "",
            installed: false,
            running: false,
        },
    ];
    // What the user typed into the search box.
    in-out property <string> filter;
    // Row the keyboard is on, or -1 while nothing is chosen. Arrow keys move it, Enter opens
    // it, and a click sets it as well, so the two ways of driving the list agree.
    in-out property <int> selected: -1;
    // True while the list is being read from disk.
    in property <bool> loading: false;

    // A row was activated: show its detail screen.
    callback open(string);
    // The Create button was pressed.
    callback create();
    // A row's Delete button was pressed. The owner asks for confirmation.
    callback delete(string);
    // A row's Launch button was pressed.
    callback launch(string);
    // The Refresh button was pressed.
    callback refresh();

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // Header: title, search, and the two list-wide actions.
        HorizontalLayout {
            spacing: Theme.gap;
            height: Theme.row-height;

            Text {
                text: "Instances";
                color: Theme.text;
                font-size: Theme.font-size-h1;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            Rectangle { horizontal-stretch: 1; }

            search_box := SearchBox {
                placeholder: "Filter instances";
                text <=> root.filter;
                moved_down => {
                    keys.focus();
                }
                horizontal-stretch: 0;
                width: 280px;
            }

            create_button := Button {
                text: "Create";
                kind: "primary";
                clicked => {
                    root.create();
                }
            }

            refresh_button := Button {
                text: "Refresh";
                enabled: !root.loading;
                clicked => {
                    root.refresh();
                }
            }
        }

        if root.loading: Text {
            text: "Loading instances…";
            color: Theme.text-muted;
            font-size: Theme.font-size;
            vertical-alignment: center;
            height: Theme.row-height;
        }

        if !root.loading && root.rows.length == 0: EmptyState {
            vertical-stretch: 1;
            title: root.filter == "" ? "No instances yet" : "No instance matches";
            message: root.filter == ""
                ? "Create one to pick a Minecraft version and a mod loader."
                : "Clear the filter to see every instance.";
        }

        // Arrow keys move the selection, Enter opens it. Anything else is rejected so the
        // shell's number shortcuts still reach the window.
        //
        // The scope is always mounted, even while the list is empty, so the search box above
        // can send the keyboard here by id. It never takes focus by itself: a click on a row
        // or Down out of the search box is what puts the keyboard in the list, so a field the
        // user is typing in is never interrupted.
        keys := FocusScope {
            // Nothing inside while the list is empty, so it claims no room and the empty
            // state below is the one that stretches.
            vertical-stretch: root.loading || root.rows.length == 0 ? 0 : 1;

            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.selected = Shell.move_selection(root.selected, -1, root.rows.length);
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    root.selected = Shell.move_selection(root.selected, 1, root.rows.length);
                    return EventResult.accept;
                }
                if (event.text == Key.Return) {
                    if (root.selected >= 0 && root.selected < root.rows.length) {
                        root.open(root.rows[root.selected].slug);
                    }
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            if !root.loading && root.rows.length > 0: ListView {
                width: 100%;
                height: 100%;

                for row[i] in root.rows: row_open := ListRow {
                    title: row.name;
                    height: Theme.row-height + Theme.gap;
                    selected: i == root.selected;
                    clicked => {
                        keys.focus();
                        root.selected = i;
                        root.open(row.slug);
                    }

                    // Name, and the slug under it when they differ.
                    Text {
                        text: row.name;
                        color: Theme.text;
                        font-size: Theme.font-size;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 100px;
                        overflow: elide;
                    }

                    Text {
                        text: row.minecraft;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        horizontal-stretch: 0;
                        width: 55px;
                        overflow: elide;
                    }

                    Text {
                        text: row.loader == "none"
                            ? "vanilla"
                            : (row.loader_version == ""
                                ? row.loader
                                : row.loader + " " + row.loader_version);
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        horizontal-stretch: 0;
                        width: 95px;
                        overflow: elide;
                    }

                    Text {
                        text: row.last_launched == "" ? "never launched" : row.last_launched;
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        horizontal-stretch: 0;
                        width: 110px;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        row_launch := Button {
                            // A launch installs whatever is missing, so an instance that was
                            // never installed can still be started. Only a running game blocks it.
                            text: row.running ? "Running" : "Launch";
                            kind: "primary";
                            enabled: !row.running;
                            clicked => {
                                root.launch(row.slug);
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        row_delete := Button {
                            text: "Delete";
                            clicked => {
                                root.delete(row.slug);
                            }
                        }
                    }
                }
            }
        }
    }
}
