import { CheckBox, ComboBox, LineEdit, ListView, ScrollView, SpinBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { InstanceState, Shell } from "../state.slint";
import { Button } from "../components/button.slint";
import { EmptyState } from "../components/empty-state.slint";
import { ListRow } from "../components/list-row.slint";
import { SettingsEditor } from "../components/settings-editor.slint";
import { TabBar } from "../components/tab-bar.slint";

// One instance's detail view: header, four tabs, and nothing else.
//
// Pure layout. Every value comes from the [`InstanceState`] global and every action is
// reported through it, so `src/screens/instance.rs` is the only place that knows what any of
// this means.
export component InstanceScreen inherits Rectangle {
    // Content row the keyboard is on, or -1 while nothing is chosen. Arrow keys move it and
    // Enter enables or disables that file, which is the row's reversible action.
    in-out property <int> selected: -1;

    // A row's source button was pressed: open that project's details. `app.slint` wires this
    // to `ProjectState.open` and `App.navigate`, the same way `BrowserScreen.open_project`
    // does, because `InstanceScreen` cannot reach either global itself (`app.slint` imports
    // this file, so the reverse import would cycle).
    callback open_project(string /* source */, string /* project_id */);
    // Smallest heap the JVM tab offers, in MiB.
    property <int> heap_min: 512;
    // Largest heap the JVM tab offers, in MiB.
    property <int> heap_max: 65536;
    // Key typed into the override editor.
    property <string> override_key;
    // Value typed into the override editor.
    property <string> override_value;
    // Whether the read-only options.txt list under Advanced is open.
    property <bool> options_open: false;
    // Whether an instance is loaded. `InstanceState.name` is empty both before the first
    // load and after `InstanceState.clear()`, which is what `app.slint` calls when the
    // screen is shown with no `App.current_slug`.
    property <bool> has_instance: InstanceState.name != "";

    background: Theme.bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // Header: who this is, what it runs, and the launch actions.
        HorizontalLayout {
            spacing: Theme.gap;

            back_button := Button {
                text: "Back";
                clicked => {
                    InstanceState.back();
                }
            }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: InstanceState.name;
                    color: Theme.text;
                    font-size: Theme.font-size-h1;
                    overflow: elide;
                }

                Text {
                    text: InstanceState.minecraft + " · " + InstanceState.loader_label
                        + (InstanceState.installed ? "" : " · not installed yet");
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    overflow: elide;
                }
            }

            if !root.has_instance: Rectangle { horizontal-stretch: 1; }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Text {
                    text: InstanceState.status_text;
                    color: Theme.text-muted;
                    font-size: Theme.font-size-small;
                    horizontal-alignment: right;
                    max-width: 320px;
                    overflow: elide;
                }
            }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                rename_button := Button {
                    text: "Rename";
                    clicked => {
                        InstanceState.rename();
                    }
                }
            }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                install_button := Button {
                    text: "Install";
                    enabled: !InstanceState.running;
                    clicked => {
                        InstanceState.install();
                    }
                }
            }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                launch_button := Button {
                    // A launch installs whatever is missing, so an instance that was never
                    // installed can still be started.
                    text: InstanceState.running ? "Running" : "Launch";
                    kind: "primary";
                    enabled: !InstanceState.running;
                    clicked => {
                        InstanceState.launch();
                    }
                }
            }

            if root.has_instance: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                stop_button := Button {
                    // Only a running game can be stopped, so the button is there exactly
                    // while Launch is not. A disabled red button still reads as one to press,
                    // so it is taken out of the row instead of dimmed.
                    text: "Stop";
                    kind: "danger";
                    visible: InstanceState.running;
                    clicked => {
                        InstanceState.stop();
                    }
                }
            }
        }

        if !root.has_instance: EmptyState {
            vertical-stretch: 1;
            title: "No instance open. Pick one from the list.";
        }

        if root.has_instance: tab_bar := TabBar {
            tabs: ["Content", "Settings", "JVM", "Logs"];
            current <=> InstanceState.tab;
            changed(index) => {
                InstanceState.set_tab(index);
            }
        }

        // Content tab: what is installed, what needs updating, what needs a hand download.
        if root.has_instance && InstanceState.tab == 0: VerticalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            HorizontalLayout {
                spacing: Theme.gap;
                height: Theme.row-height;

                check_updates_button := Button {
                    text: "Check updates";
                    clicked => {
                        InstanceState.check_updates();
                    }
                }

                apply_updates_button := Button {
                    text: "Apply updates";
                    kind: "primary";
                    enabled: InstanceState.update_count > 0;
                    clicked => {
                        InstanceState.apply_updates();
                    }
                }

                add_content_button := Button {
                    text: "Add content";
                    clicked => {
                        InstanceState.add_content();
                    }
                }

                Text {
                    text: InstanceState.update_count > 0
                        ? InstanceState.update_count + " update(s) waiting"
                        : "";
                    color: Theme.warning;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            if InstanceState.content.length == 0: EmptyState {
                vertical-stretch: 1;
                title: "Nothing installed";
                message: "Add a mod, a resource pack, or a world from the browser.";
            }

            // Arrow keys move the selection, Enter flips the chosen file between enabled and
            // disabled. Removing still needs the button: it deletes a file.
            //
            // The scope never takes focus by itself: the JVM and settings tabs are full of
            // fields, and a dialog opens over this screen, so grabbing focus on `init` would
            // pull the keyboard out of whatever the user was typing in.
            if InstanceState.content.length > 0: keys := FocusScope {
                vertical-stretch: 1;

                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.selected =
                            Shell.move_selection(root.selected, -1, InstanceState.content.length);
                        return EventResult.accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.selected =
                            Shell.move_selection(root.selected, 1, InstanceState.content.length);
                        return EventResult.accept;
                    }
                    if (event.text == Key.Return) {
                        if (root.selected >= 0 && root.selected < InstanceState.content.length) {
                            InstanceState.content_toggle(
                                InstanceState.content[root.selected].project_id,
                                !InstanceState.content[root.selected].enabled,
                            );
                        }
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }

                ListView {
                width: 100%;
                height: 100%;

                    for row[i] in InstanceState.content: row_open := ListRow {
                        title: row.name;
                        height: 2 * Theme.font-size + Theme.gap + Theme.pad;
                        selected: i == root.selected;
                        clicked => {
                            root.selected = i;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.gap / 4;
                            horizontal-stretch: 1;
                            min-width: 120px;

                            Text {
                                text: row.name;
                                color: row.enabled ? Theme.text : Theme.text-muted;
                                font-size: Theme.font-size;
                                overflow: elide;
                            }

                            Text {
                                text: row.file_name;
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: row.kind;
                            color: Theme.text-muted;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                            width: 90px;
                            overflow: elide;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            width: 80px;
                            row_source_button := Button {
                                text: row.source == "file" ? "No source page" : row.source;
                                access_label: row.source == "file"
                                    ? "No source page" : "Open on " + row.source;
                                enabled: row.source != "file";
                                clicked => {
                                    root.open_project(row.source, row.project_id);
                                }
                            }
                        }

                        Text {
                            text: row.update_available ? "update" : "";
                            color: Theme.warning;
                            font-size: Theme.font-size-small;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            horizontal-stretch: 0;
                            width: 60px;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            row_toggle := Button {
                                text: row.enabled ? "Disable" : "Enable";
                                clicked => {
                                    InstanceState.content_toggle(row.project_id, !row.enabled);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            row_delete := Button {
                                text: "Remove";
                                kind: "danger";
                                clicked => {
                                    InstanceState.content_remove(row.project_id);
                                }
                            }
                        }
                    }
                }
            }

            // Manual downloads. One block per file, each with its own path field.
            if InstanceState.pending.length > 0: VerticalLayout {
                spacing: Theme.gap;
                vertical-stretch: 0;

                Text {
                    text: "Downloads to fetch by hand";
                    color: Theme.text;
                    font-size: Theme.font-size;
                }

                for item in InstanceState.pending: entry := Rectangle {
                    property <string> path;

                    height: block.preferred-height;
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;

                    block := VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        Text {
                            text: item.file_name + " (" + item.kind + ")";
                            color: Theme.text;
                            font-size: Theme.font-size;
                            overflow: elide;
                        }

                        Text {
                            text: item.page_url;
                            color: Theme.accent;
                            font-size: Theme.font-size-small;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: Theme.gap;

                            import_path_field := LineEdit {
                                placeholder-text: "Path to the file you downloaded";
                                text <=> entry.path;
                                horizontal-stretch: 1;
                            }

                            import_button := Button {
                                text: "Import";
                                kind: "primary";
                                enabled: entry.path != "";
                                clicked => {
                                    InstanceState.import_manual(item.project_id, entry.path);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Settings tab: the typed editor over this instance's own layer, the raw key
        // editor under it, and what `options.txt` holds right now.
        if root.has_instance && InstanceState.tab == 1: VerticalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            Text {
                text: "A value set here is written into options.txt on every launch.";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Theme.gap;
                    padding-right: Theme.pad;

                    SettingsEditor { }

                    Text {
                        text: "Advanced: set a key the catalog does not know";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        height: Theme.row-height;

                        override_key_field := LineEdit {
                            placeholder-text: "key";
                            text <=> root.override_key;
                            horizontal-stretch: 1;
                        }

                        override_value_field := LineEdit {
                            placeholder-text: "value";
                            text <=> root.override_value;
                            horizontal-stretch: 1;
                        }

                        override_set_button := Button {
                            text: "Set";
                            kind: "primary";
                            enabled: root.override_key != "";
                            clicked => {
                                InstanceState.override_set(
                                    root.override_key, root.override_value);
                                root.override_key = "";
                                root.override_value = "";
                            }
                        }
                    }

                    // Before the first run there is no file to read back. Say why the list
                    // is missing, rather than leaving a gap where it would be.
                    if !InstanceState.has_options: Text {
                        text: "No options.txt yet. The game writes it on first run.";
                        color: Theme.text-muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }

                    // What the game itself last wrote. Read-only, and only shown once the
                    // file exists.
                    if InstanceState.has_options: options_toggle := Rectangle {
                        height: Theme.row-height;
                        background: Theme.surface-raised;
                        border-radius: Theme.radius;
                        accessible-role: button;
                        accessible-label: "Current options.txt";
                        accessible-expandable: true;
                        accessible-expanded: root.options_open;
                        accessible-action-default => {
                            root.options_open = !root.options_open;
                        }

                        HorizontalLayout {
                            padding-left: Theme.gap;
                            padding-right: Theme.gap;

                            Text {
                                text: (root.options_open ? "▾ " : "▸ ")
                                    + "Current options.txt";
                                color: Theme.text;
                                font-size: Theme.font-size;
                                vertical-alignment: center;
                            }
                        }

                        options_touch := TouchArea {
                            clicked => {
                                root.options_open = !root.options_open;
                            }
                        }
                    }

                    if InstanceState.has_options && root.options_open: VerticalLayout {
                        spacing: 0;

                        for row in InstanceState.options: option_row := ListRow {
                            title: row.key;

                            Text {
                                text: row.key;
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            Text {
                                text: row.value;
                                color: Theme.text-muted;
                                font-size: Theme.font-size-small;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }

        // JVM tab: heap, extra arguments, and which java to run.
        if root.has_instance && InstanceState.tab == 2: VerticalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;

            Text {
                text: "Minimum heap (MiB)";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            memory_min_spin := SpinBox {
                minimum: root.heap_min;
                maximum: root.heap_max;
                step-size: 256;
                value <=> InstanceState.jvm_min;
            }

            Text {
                text: "Maximum heap (MiB)";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            memory_max_spin := SpinBox {
                minimum: root.heap_min;
                maximum: root.heap_max;
                step-size: 256;
                value <=> InstanceState.jvm_max;
            }

            Text {
                text: "Garbage collector";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            gc_combo := ComboBox {
                model: InstanceState.gc_labels;
                current-index <=> InstanceState.gc_selected_index;
                enabled: InstanceState.gc_options.length > 0;
                // Saves on selection: unlike the heap fields' explicit Save button, a GC
                // pick is one flag, has no half-typed state to protect, and the design doc
                // wants it to take effect the moment it is chosen.
                selected => {
                    if (self.current-index >= 0
                            && self.current-index < InstanceState.gc_options.length) {
                        InstanceState.gc_pick(
                            InstanceState.gc_options[self.current-index].token);
                    }
                }
            }

            Text {
                text: InstanceState.gc_selected_index >= 0
                    && InstanceState.gc_selected_index < InstanceState.gc_options.length
                    ? InstanceState.gc_options[InstanceState.gc_selected_index].description
                    : "";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }

            gc_status_text := Text {
                text: InstanceState.gc_loading ? "Preparing Java…" : InstanceState.gc_status;
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            if InstanceState.gc_unavailable_reason != "": gc_unavailable_text := Text {
                text: InstanceState.gc_unavailable_reason;
                color: Theme.warning;
                font-size: Theme.font-size-small;
                wrap: word-wrap;
            }

            Text {
                text: "Extra JVM arguments";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            jvm_args_field := LineEdit {
                placeholder-text: "-XX:+UseG1GC";
                text <=> InstanceState.jvm_extra;
            }

            Text {
                text: "Java path";
                color: Theme.text-muted;
                font-size: Theme.font-size-small;
            }

            java_path_field := LineEdit {
                placeholder-text: "leave empty to let the launcher choose";
                text <=> InstanceState.java_path;
            }

            HorizontalLayout {
                spacing: Theme.gap;
                height: Theme.row-height;

                Text {
                    text: InstanceState.jvm_min > InstanceState.jvm_max
                        ? "The minimum heap is above the maximum."
                        : "";
                    color: Theme.danger;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                jvm_save_button := Button {
                    text: "Save";
                    kind: "primary";
                    enabled: InstanceState.jvm_min <= InstanceState.jvm_max;
                    clicked => {
                        InstanceState.jvm_save(
                            InstanceState.jvm_min,
                            InstanceState.jvm_max,
                            InstanceState.jvm_extra,
                            InstanceState.java_path,
                        );
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // Logs tab: what the game printed, newest at the bottom.
        if root.has_instance && InstanceState.tab == 3: Rectangle {
            // Where the log view sits when it is following the newest line.
            property <length> follow: min(0px, log.visible-height - log.viewport-height);

            // Following is done on a change, not as a binding, so a user who scrolls away
            // with autoscroll off is left alone.
            changed follow => {
                if (InstanceState.autoscroll) {
                    log.viewport-y = self.follow;
                }
            }

            VerticalLayout {
                spacing: Theme.gap;

                HorizontalLayout {
                    spacing: Theme.gap;
                    height: Theme.row-height;

                    autoscroll_check := CheckBox {
                        text: "Auto-scroll";
                        checked <=> InstanceState.autoscroll;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    open_logs_button := Button {
                        text: "Open log folder";
                        clicked => {
                            InstanceState.open_log_folder();
                        }
                    }
                }

                log := ListView {
                    vertical-stretch: 1;

                    for line in InstanceState.game_log: Rectangle {
                        height: line_text.preferred-height + Theme.gap;
                        background: Colors.transparent;

                        line_text := Text {
                            x: Theme.pad;
                            width: parent.width - 2 * Theme.pad;
                            text: line.text;
                            color: line.level == "error" || line.level == "warn"
                                ? Theme.warning
                                : Theme.text-muted;
                            font-size: Theme.font-size-small;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }

                if InstanceState.game_log.length == 0: Text {
                    text: "No game output yet. Launch the instance to see its log here.";
                    color: Theme.text-muted;
                    font-size: Theme.font-size;
                    height: Theme.row-height;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Preview only: `just ui-preview screens/instance.slint` renders this one, because a viewer
// with no `--component` shows the last exported component of the file.
//
// `InstanceState` starts empty, so the screen on its own would preview as a nameless
// instance with no content and no log. This component fills the global with the sample
// values it used to carry as its defaults. Nothing in the app instantiates it.
export component PreviewInstanceScreen inherits InstanceScreen {
    init => {
        InstanceState.name = "Fabric Performance";
        InstanceState.minecraft = "1.20.1";
        InstanceState.loader_label = "fabric 0.16.9";
        InstanceState.installed = true;
        InstanceState.status_text = "Ready";
        InstanceState.has_options = true;
        InstanceState.jvm_min = 2048;
        InstanceState.jvm_max = 4096;
        InstanceState.jvm_extra = "-XX:+UseG1GC";
        InstanceState.gc_token = "g1";
        InstanceState.gc_options = [
            { token: "default", label: "Launcher default", description: "Launcher default: no collector flag, the JVM chooses" },
            { token: "g1", label: "G1", description: "G1: balanced pauses and throughput, the usual choice" },
            { token: "zgc", label: "ZGC", description: "ZGC: low pause times, needs more memory" },
        ];
        InstanceState.gc_labels = ["Launcher default", "G1", "ZGC"];
        InstanceState.gc_selected_index = 1;
        InstanceState.gc_status = "Java 21.0.4 from the Mojang runtime";
        InstanceState.update_count = 1;
        InstanceState.content = [
            {
                project_id: "AANobbMI",
                source: "modrinth",
                name: "Sodium",
                version: "OrgTMPmO",
                kind: "mod",
                enabled: true,
                update_available: true,
                file_name: "sodium-fabric-0.5.8.jar",
            },
            {
                project_id: "gvQqBUqZ",
                source: "modrinth",
                name: "Lithium",
                version: "ZSNsJrPI",
                kind: "mod",
                enabled: false,
                update_available: false,
                file_name: "lithium-fabric-0.11.2.jar.disabled",
            },
        ];
        InstanceState.pending = [
            {
                project_id: "1IjD5062",
                file_name: "continuity-3.0.0.jar",
                page_url: "https://www.curseforge.com/minecraft/mc-mods/continuity/files/1234",
                kind: "mod",
            },
        ];
        InstanceState.options = [
            { key: "version", value: "3465" },
            { key: "fov", value: "0.5" },
        ];
        InstanceState.game_log = [
            { level: "info", text: "[Render thread/INFO]: Setting user: Steve" },
            { level: "info", text: "[Render thread/INFO]: Loaded 7 recipes" },
        ];
    }
}
