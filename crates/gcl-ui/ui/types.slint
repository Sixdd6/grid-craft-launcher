// Data that crosses the Rust/Slint boundary. Rust builds these as VecModels in src/models/.

// One instance in the instances list.
export struct InstanceRow {
    slug: string,
    name: string,
    minecraft: string,
    loader: string,
    loader_version: string,
    last_launched: string,
    installed: bool,
    running: bool,
}

// One installed file inside an instance.
export struct ContentRow {
    project_id: string,
    source: string,
    name: string,
    version: string,
    kind: string,
    enabled: bool,
    update_available: bool,
    file_name: string,
}

// One search hit from a content source.
export struct SearchRow {
    source: string,
    project_id: string,
    slug: string,
    title: string,
    description: string,
    author: string,
    kind: string,
    downloads: string,
    page_url: string,
}

// One saved account.
export struct AccountRow {
    id: string,
    name: string,
    kind: string,
    expires: string,
    active: bool,
}

// One tracked task. `status` is running, done, or failed.
export struct TaskRow {
    id: int,
    label: string,
    fraction: float,
    status: string,
    detail: string,
}

// One transient message stacked over the shell. `kind` is warning, error, or info.
export struct ToastRow {
    text: string,
    kind: string,
}

// One line in the app log.
export struct LogLine {
    level: string,
    text: string,
}

// One editable setting.
export struct SettingRow {
    key: string,
    value: string,
}

// One line of the typed settings editor: a group header, or one setting with the control it
// is edited with.
//
// `control` is "group" for a header, else "slider", "toggle", "choice", or "text". A header
// carries the group name in `label`, how many settings it holds in `choice_index`, and
// whether it is open in `checked`. Everything else is a setting row: `value` is the string
// `options.txt` would hold, and the typed fields are the same value read for its control.
//
// A slider row is carried in the numbers a user reads, not the numbers `options.txt` holds:
// `number`, `minimum`, `maximum` and `step` are already scaled, `unit` is what follows the
// number, and `display_decimals` says how many digits it is written with. `decimals` stays
// the stored precision, which only `src/models/settings.rs` uses. For every setting but
// `fov` the two are the same number.
export struct SettingRowModel {
    key: string,
    label: string,
    group: string,
    control: string,
    value: string,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    decimals: int,
    display_decimals: int,
    unit: string,
    checked: bool,
    choices: [string],
    choice_index: int,
    source: string,
    inherited: bool,
    resettable: bool,
}

// One loader build offered for an instance.
export struct LoaderVersionRow {
    version: string,
    stable: bool,
    recommended: bool,
}

// One Minecraft version from the Mojang manifest.
export struct VersionRow {
    id: string,
    kind: string,
    release_time: string,
}

// One download the user still has to fetch by hand.
export struct PendingRow {
    project_id: string,
    file_name: string,
    page_url: string,
    kind: string,
}

// One piece of a project's rendered description, from `richtext::Block` in gcl-core.
//
// `kind` is one of `heading1`..`heading6`, `paragraph`, `bullet`, or `code`. A link inside
// `text` already reads `text (url)`, per `richtext`'s own conversion, so the screen renders
// `text` as plain wrapped prose with no further markup to interpret.
export struct Block {
    kind: string,
    text: string,
}

// One version row on the project details screen's Versions tab.
//
// `game_versions` and `loaders` are pre-joined for display, the same way other rows in this
// file avoid passing an array where a joined string prints fine. `installed` marks the row
// whose `id` matches the target instance's installed `version_id` for this project.
export struct ContentVersionRow {
    id: string,
    number: string,
    kind: string,
    release_time: string,
    game_versions: string,
    loaders: string,
    installed: bool,
}

// Which screen the shell shows.
export enum Screen {
    instances,
    instance,
    browser,
    accounts,
    settings,
    project,
}
