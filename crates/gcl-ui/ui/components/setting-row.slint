import { ComboBox, LineEdit, Slider, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingRowModel } from "../types.slint";
import { Button } from "button.slint";

// One setting, edited with the control its catalog entry names.
//
// Pure layout. The row reports what the user did and never decides what it means: a slider
// sends the number a user reads and a choice sends the position it picked, and
// `src/screens/settings_editor.rs` turns either one into the value `options.txt` stores.
// That is why a slider has its own callback: `fov` is shown in degrees and stored as a
// float in [-1, 1], so only Rust may write it.
//
// A slider saves when the drag ends, or `commit_delay` after the last change when no release
// follows — an arrow key, or a screen reader's increment — so one drag is one save and not
// one save per pixel. A choice waits the same delay before it saves, because a ComboBox
// reports every arrow step and every wheel tick as a pick: one save after the picking stops.
export component SettingRow inherits Rectangle {
    in property <SettingRowModel> entry;
    // False while a save is running: every control is dead until the rows come back.
    in property <bool> enabled: true;
    callback changed(string /* key */, string /* value */);
    callback slid(string /* key */, float /* shown */);
    callback chose(string /* key */, int /* index */);
    callback reset(string /* key */);

    // How long after the last change a value is saved, when no release follows.
    property <duration> commit_delay: 500ms;
    // The position the choice combo last reported, saved when `choice_commit` fires.
    property <int> pending_choice: -1;

    height: Theme.row-height + Theme.gap;
    // The row itself is what a test and a screen reader find the setting by: the key names
    // it, the label describes it, and the value is the string `options.txt` would hold.
    accessible-role: text;
    accessible-label: root.entry.key;
    accessible-description: root.entry.label;
    accessible-value: root.entry.value;

    HorizontalLayout {
        spacing: Theme.gap;

        VerticalLayout {
            alignment: center;
            width: 2 * Theme.label-width;

            Text {
                text: root.entry.label;
                color: root.entry.inherited ? Theme.text-muted : Theme.text;
                font-size: Theme.font-size;
                overflow: elide;
            }
        }

        // The control. Exactly one of these is built, by the row's kind.
        if root.entry.control == "slider": Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: Theme.gap;

                setting_slider := Slider {
                    minimum: root.entry.minimum;
                    maximum: root.entry.maximum;
                    step: root.entry.step;
                    value: root.entry.number;
                    enabled: root.enabled;
                    horizontal-stretch: 1;
                    changed(value) => {
                        // `restart()` is what puts the delay back: assigning `running` the
                        // value it already holds changes nothing and the timer would fire
                        // `commit_delay` after the *first* change instead of the last.
                        commit.running = true;
                        commit.restart();
                    }
                    released(value) => {
                        commit.running = false;
                        root.slid(root.entry.key, value);
                    }
                }

                // The number a user reads, in the row's own unit, following the thumb while
                // it is dragged. A test reads it through the accessible label.
                setting_value := Text {
                    text: setting_slider.value.to-fixed(root.entry.display_decimals)
                        + root.entry.unit;
                    color: Theme.text;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    width: Theme.status-width;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }

            commit := Timer {
                interval: root.commit_delay;
                running: false;
                triggered => {
                    self.running = false;
                    root.slid(root.entry.key, setting_slider.value);
                }
            }
        }

        if root.entry.control == "toggle": Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                alignment: start;

                setting_switch := Switch {
                    checked: root.entry.checked;
                    enabled: root.enabled;
                    toggled => {
                        root.changed(root.entry.key, self.checked ? "true" : "false");
                    }
                }
            }
        }

        if root.entry.control == "choice": Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                alignment: start;

                setting_combo := ComboBox {
                    model: root.entry.choices;
                    current-index: root.entry.choice_index;
                    enabled: root.enabled;
                    width: 2 * Theme.label-width;
                    selected => {
                        root.pending_choice = self.current-index;
                        choice_commit.running = true;
                        choice_commit.restart();
                    }
                }
            }

            choice_commit := Timer {
                interval: root.commit_delay;
                running: false;
                triggered => {
                    self.running = false;
                    root.chose(root.entry.key, root.pending_choice);
                }
            }
        }

        if root.entry.control == "text": Rectangle {
            horizontal-stretch: 1;

            HorizontalLayout {
                setting_field := LineEdit {
                    text: root.entry.value;
                    enabled: root.enabled;
                    horizontal-stretch: 1;
                    accepted(value) => {
                        root.changed(root.entry.key, value);
                    }
                    // Leaving the field is the other way a typed value is finished: without
                    // this, text edited and then clicked away from is silently dropped.
                    changed has-focus => {
                        if !self.has-focus && self.text != root.entry.value {
                            root.changed(root.entry.key, self.text);
                        }
                    }
                }
            }
        }

        // Where the shown value comes from: default, preseed, file, or override.
        VerticalLayout {
            alignment: center;
            width: 3 * Theme.status-width / 2;

            Text {
                text: root.entry.source;
                color: root.entry.inherited ? Theme.text-muted : Theme.accent;
                font-size: Theme.font-size-small;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 5 * Theme.status-width / 4;

            if root.entry.resettable: setting_reset_button := Button {
                text: "Reset";
                enabled: root.enabled;
                clicked => {
                    root.reset(root.entry.key);
                }
            }
        }
    }
}
